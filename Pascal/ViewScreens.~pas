procedure TfrmViewScreens.FormMouseWheel(Sender: TObject; Shift: TShiftState;
  WheelDelta: Integer; MousePos: TPoint; var Handled: Boolean);
// 19.12.07 P.W
const
  SF = 1.1;
var
  NumDelta, I, dP : Integer;
  ScaleFact : Double;
  MP : TPoint;
begin
  NumDelta := WheelDelta div WHEEL_DELTA;
  Handled := True;
  if (ssCtrl in Shift) then
  begin
    ScaleFact := Power(SF, NumDelta);
    NewZoom(ScaleFact * Scale);
  end else
  begin
    if LargeScrollBars then
    begin
      dP := - Round(0.1 * NumDelta * sbVert.Max);
      sbVert.Position := Min(sbVert.Max - sbVert.PageSize,       sbVert.Position + dP);
    end else
    begin
      MP := Mouse_CursorPos;
      for I := 0 to ImageCount -1 do
      if Assigned(Images[I])  then
//    if Images[I].Focused then // never focused!
      if WindowFromPoint(MP) = Images[I].Handle then
      begin
        dP := - Round(0.1 * NumDelta * Images[I].VertScrollBar.Range);
        Images[I].VertScrollBar.Position := Images[I].VertScrollBar.Position + dP;
      end;
    end;
  end;
end;

procedure TfrmViewScreens.imgMouseDown(Sender: TObject;
  Button: TMouseButton; Shift: TShiftState; X, Y: Integer);
// 19.12.07 P.W
var
  I : Integer;
  MP : TPoint;
begin
  Include(imgMouseButtons, Button);
  imgMouseDwnPos       := Mouse_CursorPos;// Point(X, Y);   // Use ScreenCoordinates!
  if LargeScrollBars then
  begin
    imgMouseDwnScrollPos := Point(sbHorz.Position, sbVert.Position);
    ImgMouseDwnImgIdx := -1;
  end else
  begin
    MP := Mouse_CursorPos;
    for I := 0 to ImageCount -1 do
    if Assigned(Images[I])  then
    if WindowFromPoint(MP) = Images[I].Handle then
    begin
      imgMouseDwnScrollPos := Point(Images[I].HorzScrollBar.Position, Images[I].VertScrollBar.Position);
      ImgMouseDwnImgIdx := I;
    end;
  end;
end;

procedure TfrmViewScreens.imgMouseMove(Sender: TObject; Shift: TShiftState;
  X, Y: Integer);
// 19.12.07 P.W
var
  PS, PM : TPoint;
  I : Integer;
begin
  if (mbLeft in imgMouseButtons) then
  begin
    PM := Mouse_CursorPos; // Point(X, Y);   // Use ScreenCoordinates! (X, Y depend on ScrollBar.Position!)
    PS := PointsAdd(imgMouseDwnScrollPos, PointsSub(imgMouseDwnPos, pM));
    if LargeScrollBars then
    begin
      sbHorz.Position := Min(sbHorz.Max - sbHorz.PageSize, PS.X);
      sbVert.Position := Min(sbVert.Max - sbVert.PageSize, PS.Y);
    end else
    begin
      for I := 0 to ImageCount -1 do
      if Assigned(Images[I])  then
      if (I = ImgMouseDwnImgIdx) then
      begin
        Images[I].HorzScrollBar.Position := PS.X;
        Images[I].VertScrollBar.Position := PS.Y;
      end;
    end;
  end;
end;

