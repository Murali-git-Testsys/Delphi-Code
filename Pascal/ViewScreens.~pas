{ TScrollImage }

constructor TScrollImage.Create(aOwner: TComponent);
begin
  inherited Create(aOwner);
  // Self :     TScrollImage (TScrollBox with an Image)
  Edit := TEdit.Create(Self);
  Edit.Parent := Self;

  Edit.ReadOnly := True;
  Edit.AutoSize := True;
  Edit.Align := alTop;

  Img := TImage.Create(Self);
  Img.Parent := Self;
  Img.Align  := alClient;
  Img.Top    := Edit.Height + 4;  // 28.06.05 P.W
  FileName   := '';

  HorzScrollBar.Tracking := True; // 27.07.06 P.W
  VertScrollBar.Tracking := True; // 27.07.06 P.W
end;

destructor TScrollImage.Destroy;
begin
  Img.Free;
  inherited Destroy;
end;

