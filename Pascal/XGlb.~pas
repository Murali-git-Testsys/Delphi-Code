(** Function Name    : Clip_MQ                                            **)
(** Author           : P.Wueseke                                          **)
(** Date             : 20.06.97                                           **)
(** Description      : Returns an value for measquality limited to +-125  **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : -                                                  **)
(** Input            : s                                                  **)
(** Output           : RETURN (ShortInt): Round(s)                        **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : -                                                  **)
(***************************************************************************)
(** Last modified/By : -                                                  **)
(** Date/Modification: -                                                  **)
(**************************************************************************.*)
Function  Clip_MQ(s: Single): ShortInt;
begin
  If s < -125 then s:= -125
  else
  If s >  125 then s:=  125;
  Clip_MQ:=Round(s);
end;

(*.**************************************************************************)
(** Function Name    : CalcClip_MQ                                        **)
(** Author           : P.Wueseke                                          **)
(** Date             : 20.06.97                                           **)
(** Description      : Calculate: 100.0 * ((ChkVal/ChkLim) - 1.0)         **)
(** Description      : and clip the result with Clip_MQ                   **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : Clip_Mq                                            **)
(** Input            : ChkVal, LimVal                                     **)
(** Output           : RETURN (ShortInt): s clipped                       **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : -                                                  **)
(***************************************************************************)
(** Last modified/By : 09.07.97 / P.Wueseke                               **)
(** Date/Modification: 09.07.97 P.W / Sign inverted                       **)
(**************************************************************************.*)
Function  CalcClip_MQ(ChkVal, LimVal: Single): ShortInt;
begin
  CalcClip_MQ:=Clip_MQ(-100.0 * ((ChkVal / LimVal) -1.0));
                       {^--- "-": 09.07.97 P.W}
end;

Procedure AddChkSumDR(Var ChkSum: tChkSum; Const aDR: tDetRec);
(*
{25.09.02 P.W}
1) to the chkSum add the data of DR with MeasInfo4 fix content
2) aDR is not changed! (this by use of DR_Loc as copy of aDR)
*)
  Procedure FillStringEnd(Var aString; Size: Word; FChar: Char);
  Var
    L, P           : Smallint;
  begin
    L := Length(String(aString));
    P := Size - L -1;
    If (P > 0) then
      FillChar(String(aString)[L+1], P, FChar);
  end;

Var
  DR_Loc           : pDetRec;
  I                : Smallint;
begin
  New(DR_Loc);
  DR_Loc^ := aDR;
  With DR_Loc^ do
  begin
    {prepare fields for checksum that might change later:}

    ZPos_NumSteps:=0;  {temporary for calculation of ChkSum (SV }
          {^-- might be changed if "F4" is used to terminate SV}
    NumSlices    :=0;  {temporary for calculation of ChkSum }
          {^-- might be changed for a CT if "SvStudy Add Slice is used"}

    {clear the field MeasInfo[4] before continued calculation of ChkSum}
    FillChar(MeasInfo[4], SizeOf(MeasInfo[4]), #5);

    {define the unused parts of String types:}
    For I:= 1 to 3 do
      FillStringEnd(MeasInfo[I], SizeOf(MeasInfo[I]), #0);

    FillStringEnd(DeviceTyp, SizeOf(DeviceTyp), #0);
  end;
  {1) now complete the calculation of ChkSum:}
  AddChkSum(ChkSum, DR_Loc^, SizeOf(DR_Loc^));  {DR_Loc^ to ChkSum; changes only ChkSum}
  Dispose(DR_Loc);
end;

Procedure SetDefault;{from XGLB_FB to XGLB: 25.09.02 P.W}
// Modifications:
// 23.01.09 P.W use FillChar to initialize all fields to zero
// this change is only for convenience
// XbJob.pas Function Work1 is clearing all fields before creating INIT\PAT.REC
// so without the change: all headers in have already zeroed fields (especially free for future use)
begin
  FillChar(PatInfoRec_^, SizeOf(PatInfoRec_^), #0);  // 23.01.09 P.W
  With PatInfoRec_^ do
  begin
    RecSize        := SizeOf(PatInfoRec_^);
    PatGender      :=         1;
    PatEthnicGrp   :=         0;
    PatMeasNo      :=         1;         { Patients meas number }
    PatNo          :=         1;         { Patient number }
    PatBirth       :=         1;
    PatMenoAge     :=         0;
    PatName        := 'N.N.'   ;         { Patient familyname & firstname }
    PatTitle       := 'Dr.'    ;
    PatComment     := 'PatCommment';
  end;

end;




