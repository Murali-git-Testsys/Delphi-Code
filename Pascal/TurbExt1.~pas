Procedure AddChar(Var Txt:String; Ch:Char);
{ Nur Strings der Länge 255! } //OemToAnsi Chg#226 (02.03.04 P.W)
Var
  Len : Byte absolute Txt;
begin
  if Len=255 then exit;
  inc(Len);
  Txt[Len]:=Ch;
end;

