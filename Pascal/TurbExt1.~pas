(** Function Name    : InvValOptD                                         **)
(** Author           : P.Wueseke                                          **)
(** Date             : 01.02.96                                           **)
(** Description      : Optimize Format of Double: Use maximum of dezimals **)
(** Description      :   to use MinFieldLen                               **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : DelSpcLeft                                         **)
(** Input            : D, MinFieldLen, DelZeroFlg                         **)
(** Output           : RETURN: Formated Double as String                  **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : -                                                  **)
