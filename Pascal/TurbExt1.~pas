Function CentreTxt(Txt:String; Ch:Char; FieldLen:Byte):String;
Var
  Len         : Byte absolute Txt;
begin
  if FieldLen>254 then FieldLen:=254;
  if Len<FieldLen then
  begin
    While Len<FieldLen do Txt:=Ch + Txt + Ch;
    Len:=FieldLen;
  end;
  CentreTxt:=Txt;
end;

