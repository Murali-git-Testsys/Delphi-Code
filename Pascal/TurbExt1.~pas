Function LeadZero(Nr,Len:LongInt):String;
Var
  Txt         : String;
begin
  Str(Nr,Txt);
  While (Length(Txt)<Len) do Txt:='0'+Txt;
  if (Length(Txt)>Len) then Txt:='';
  LeadZero:=Txt;
end;
