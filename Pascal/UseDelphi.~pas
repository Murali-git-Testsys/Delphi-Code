procedure SetOutSideClick(MouseX, MouseY: Integer); // 25.10.04 P.W.
// also for Mouse Move
begin
  if LMouseDown then
  begin
    OutSideClickMouseX := MouseX;
    OutSideClickMouseY := MouseY;
    OutSideClicked := True;
  end;
end;

