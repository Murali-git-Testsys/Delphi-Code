procedure RegisterPaneKeyWorld(x1, y1, x2, y2: Double);  // 30.04.04 P.W
// called by
//   a) UtParam.pas Procedure TGenParams.SetThreshold
//   b) KN_Slc0.pas Procedure DoSetRoi (sub-) Procedure DrawSliceImage;
