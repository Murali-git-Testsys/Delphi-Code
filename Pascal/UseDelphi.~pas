procedure CheckViewPortSortOrder(var aViewPort: ViewPortType);
  procedure CheckSort(var a, b: SmallInt);
  var
    h : SmallInt;
  begin
    If (a > b) then
    begin
      h := a;
      a := b;
      b := h;
    end;
  end;
begin
  CheckSort(aViewPort.x1, aViewPort.x2);
  CheckSort(aViewPort.y1, aViewPort.y2);
end;

