function  GetSvMirrorHoriz(const ODR: tOrientDirRec; const Default: Boolean; InvertFlg:Boolean=False): Boolean;
begin
  if IsOrientInfoSup(ODR) then
    Result := ((ODR.Info_MirrorBits and SvMirrorHoriz_Msk)  <> 0) xor InvertFlg
  else
