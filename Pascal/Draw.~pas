        end else
        begin
          EXIT;
        end;
      end;
    end else
    begin
      EXIT;
    end;
  end;

  NewGraphic := GraphicClass.Create;
  try
//    NewGraphic.OnProgress := Progress;
    NewGraphic.Assign(aBitMap);
    ForceDirectories(ExtractFilePath(aFileName));
    NewGraphic.SaveToFile(aFilename);
