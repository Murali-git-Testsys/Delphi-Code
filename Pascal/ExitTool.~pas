Unit ExitTool;

INTERFACE

Uses
  Tools,
  GlbType;

var
  SaveUnitName     : String08   =  '';
  SaveExitCode     : Smallint   =   0;
  SaveErrorAddr    : Pointer    = Nil;

Type
  tExitProc = Procedure;

Procedure ChkSaveExitCode(Const A_UnitName: String08);
Procedure GetSaveExitCodeStr(Var Msg : String30);

Function AddExitProc(AddProc: tExitProc; Const Msg: String): Pointer;
{Caller must store the Returnvalue in its local OldExitProc}
{example:
