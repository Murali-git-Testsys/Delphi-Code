{07.06.99 P.W}

Function AddExitProc(AddProc: tExitProc; Const Msg: String): Pointer;
// Turbo To Delphi; manually remove use of "LastExitProc" (08.03.04 P.W)
begin
  Result := ExitProc;
  ExitProc := @AddProc;
end;
{--------------------------------------------------------------------}

Procedure ChkSaveExitCode(Const A_UnitName: String08);
begin
  If (SaveExitCode=0) and (ExitCode<>0) then
  begin
    SaveUnitName   := A_UnitName;
    SaveExitCode   := ExitCode;
    SaveErrorAddr  := ErrorAddr;
  end;
end;

(*.**************************************************************************)
(** Procedure Name   : GetSaveExitCodeStr                                 **)
(** Author           : P.Wueseke                                          **)
(** Date             : 01.09.97                                           **)
(** Description      : Make a string out of SaveExitcode, ...             **)
(** Description      : Avoid "+" of strings to spare stack                **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : -                                                  **)
(** Input            : -                                                  **)
(** Output           : RETURN (String40): Ret                             **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : SaveExitCode, SaveErrorAddr, SaveUnitName          **)
(***************************************************************************)
(** Last modified/By : -                                                  **)
(** Date/Modification: -                                                  **)
(**************************************************************************.*)
Procedure GetSaveExitCodeStr(Var Msg : String30);
  Procedure Add(Const AStr: String30);
  Var
    LM, I          : Smallint;
  begin
    LM:=Length(Msg);
    I :=Length(AStr);
    If ((LM+I) <= (SizeOf(Msg)-1)) then
    begin
      For I:=1 to Length(AStr) do Msg[LM+I]:=AStr[I];
      Inc(Msg[0], Length(AStr));
    end;
  end;
begin
  Msg := '';
  Add('EC=');
  Add(InvVal(SaveExitCode,1));
  if (SaveExitCode<>0) then
  begin
    Add(' EA=');
    Add(InvValHex(LongInt(SaveErrorAddr),8));
    Add(' ');
    Add(SaveUnitName);
  end;
end;

end.
