procedure TfrmPrint.TestScaledImg(dx: Integer = 2; dy: Integer = 2);
// scale down by using the interpolated result of neighbours:
// thin lines are not lost, but color changes
  procedure AddRgb(const C: Integer; var R, G, B: Integer);
  var
    Rc, Gc, Bc: Integer;
  begin
    // pf16bit :
    begin
      Rc := (C and $F800) shr 8;
      Gc := (C and $07E0) shr 3;
      Bc := (C and $001F) shl 3;
  //    Result :=   ((R shr 3) shl 11)       // result bits: rrrr rggg gggb bbbb
  //              + ((G shr 2) shl  5)
  //              + ((B shr 3) shl  0);
    end;
    Inc(R, Rc);
    Inc(G, Gc);
    Inc(B, Bc);
  end;

  function  ColRgb(const R, G, B: Integer): Integer;
  begin
    // pf16bit :
    result :=   ((R and $F8) shl 8)
              + ((G and $FA) shl 3)
              + ((B and $F8) shr 3);
  end;

var
  Ws, Hs,
  Wd, Hd,
  xd, yd : Integer;
  xs, ys : Integer;
  ix, iy : Integer;
  SLs : Array [0..8000] of  PBmpArr;
  SLd : Array [0..8000] of  PBmpArr;
  BmpD: TBitMap;
  R, G, B, C : Integer;
  dxdy : Integer;
begin
//  dy := 1; dx := 1;
  Ws := imgPrint.Picture.Width;
  Hs := imgPrint.Picture.Height;

  Wd := (Ws-1) div dx;
  Hd := (Hs-1) div dy;

  BmpD := TBitMap.Create;
  BmpD.PixelFormat:= BmpPixFmt;
  BmpD.Width  := Wd;
  BmpD.Height := Hd;

  dxdy := dx * dy;

  for ys := 0 to Hs -1 do
    SLs[ys] := imgPrint.Picture.Bitmap.ScanLine[ys];

  for yd := 0 to Hd -1 do
    SLd[yd] := BmpD.ScanLine[yd];

  for yd := 0 to Hd -1 do
  begin
    ys := yd * dy;
    for xd := 0 to Wd -1 do
    begin
      xs := xd * dx;
      R := 0; G := 0; B := 0;
      for iy := 0 to dy -1 do
        for ix := 0 to dx -1 do
          begin
            C := SLs[ys + iy, xs + ix];
            AddRgb(C, R, G, B);

          end;
      //SLd[yd,xd]:= random($FFFF);
      //SLd[yd,xd] := SLs[ys, xs];

      R := R div dxdy;
      G := G div dxdy;
      B := B div dxdy;
      C := ColRGB(R, G, B);
      SLd[yd,xd] := C;
    end;
  end;
  imgPrint.Picture.Bitmap.Assign(BmpD);
  FreeAndNil(BmpD);
  imgPrint.Repaint;
end;

