  {$I-}
    If Addr(DR)=Addr(GlbDetRec) then   {06.08.97 P.W}
      GlbDetRec_Chk_DebugName:=FExpand(Name);    {06.08.97 P.W}

    Assign(Inp, FExpand(Name)); // FExpand added (03.03.04 P.W)
    Reset (Inp, 1);
      ResH:=IoResult; If (Res=0) then Res:=ResH;
    If (Res=0) then
    begin
      Seek(Inp, SizHeadPart1);  {Offset of 16 Bytes}
        ResH:=IoResult; If (Res=0) then Res:=ResH;
      If (Res=0) then
      begin
        BlockRead(Inp, DR, SizeOf(DR), Result_);
          ResH:=IoResult; If (Res=0) then Res:=ResH;
        If (Res=0) and (Result_<>SizeOf(DR)) then Res:=Err_DiskRead;
        DR.RecSize:=SizeOf(DR);   {15.09.97 P.W}
      end;
    end;
    Close (Inp);
      ResH:=IoResult; If (Res=0) then Res:=ResH;
  {$I+}
  end else
  begin
    Res:=Err_DiskRead;
  end;
  FindDetRec:=Res;
end;
