Function  ChkLoadFindGlbDetCtRec(
           Const Name: PathStr; FindFlg: Boolean): Smallint;
Var
  Res              : Smallint;
begin  {Func. ChkLoadFindGlbDetCtRec}
  Res:=0;
  If (Name<>'') and (Name<>'NUL') then
  begin
    If FindFlg then
    begin
      Res:=FindDetRec(Name, GlbDetRec);  {reads from byte pos. 16}
      {expect PatInfoRec behind DetRec:}
      If (Res=0) then Res:=
        ReadDetRecPartMeas(Name,
                           PatInfoRec_^,
                           SizeOf(PatInfoRec_^),
                           SizeOf(GlbDetRec));  {Position behind DetRec}
    end else
    begin
      Res:=LoadDetRec(Name, GlbDetRec);  {reads from byte pos.  0}
    end;
    If (Res<>0) then
      ErrHalt(Res, 'reading file:', '"'+ FExpand(Name) + '"');

    If UpStr(GlbDetRec.DeviceTyp)<>UpStr(GlbDevSnr.DeviceTyp) then {06.03.97 P.W}
    begin
      ErrHalt(-1, 'DeviceTyp is not equal in "'+ Name + '"',
                  'and "' + LocDevSnrFile + '"');
    end;
  end;
  ChkLoadFindGlbDetCtRec:=Res;
end;   {Func. ChkLoadFindGlbDetCtRec}

