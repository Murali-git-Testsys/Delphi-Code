      DDD.VoxSiz_['A']           := GetD  ('VoxelSize_A');
      DDD.VoxSiz_['B']           := GetD  ('VoxelSize_B');
    {----------------------------------------------------------------}
    {09.12.96 P.W}
    My_Section:='[HvCheck]';
      DDD.HvOffChkFlg            := GetBoo('HvOffChkFlg');
      DDD.HvOffChkSec_A          := GetD  ('HvOffChkSec_A');
      DDD.HvOffMaxKV_A           := GetD  ('HvOffMaxKV_A');
      DDD.HvOffMaxMA_A           := GetD  ('HvOffMaxMA_A');
      DDD.HvOffChkSec_B          := GetD  ('HvOffChkSec_B');
      DDD.HvOffMaxKV_B           := GetD  ('HvOffMaxKV_B');
      DDD.HvOffMaxMA_B           := GetD  ('HvOffMaxMA_B');
      DDD.HvOnChkFlg             := GetBoo('HvOnChkFlg');
      DDD.HvOnChkSec_A           := GetD  ('HvOnChkSec_A');
      DDD.HvOnMaxDeltaKV_A       := GetD  ('HvOnMaxDeltaKV_A');
      DDD.HvOnMaxDeltaMA_A       := GetD  ('HvOnMaxDeltaMA_A');
      DDD.HvOnChkSec_B           := GetD  ('HvOnChkSec_B');
      DDD.HvOnMaxDeltaKV_B       := GetD  ('HvOnMaxDeltaKV_B');
      DDD.HvOnMaxDeltaMA_B       := GetD  ('HvOnMaxDeltaMA_B');
    {----------------------------------------------------------------}
    {17.06.97 P.W}
    My_Section:='[Measurement]';
      DDD.MQCheckON              := GetBoo('MQCheckON'    );
      GetMqThr(DDD.MQLnChk      , 'MQLnChk'               );
      GetMqThr(DDD.MQOffsetChk  , 'MQOffsetChk'           );
      GetMqThr(DDD.MQRangeChk   , 'MQRangeChk'            );
      DDD.EdgeThr                := GetD  ('EdgeThr'      ); {23.06.97 P.W}
      {--------------------------------------------------------------}
      {26.06.97 P.W}
      WarnDeltaZmm         := GetD('WarnDeltaZmm'   );
      DDD.SlicePauseLimit  := GetD('SlicePauseLimit');{Lim->Limit:18.07.97 P.W}
      DDD.SlicePauseMinimum:= GetD('SlicePauseMinimum'); {18.07.97 P.W}
      DDD.SlicePauseDetOn  := GetD('SlicePauseDetOn');   {18.07.97 P.W}
      DDD.SlicePausePerc   := GetD('SlicePausePerc' );
    {--------------------------------------------------------------}
    {since 20.03.97 P.W}
    My_Section:='[BackProjection]';
      DDD.CtMirrorHoriz    := GetBoo('CtMirrorHoriz'); {EH: {28.05.97 P.W}
      DDD.CtMirrorVert     := GetBoo('CtMirrorVert');  {EH: {28.05.97 P.W}
    {----------------------------------------------------------------}
    {since 03.06.97 P.W}
    My_Section:='[ScoutView]';
      DDD.SvMirrorHoriz    := GetBoo('SvMirrorHoriz');
      DDD.SvMirrorVert     := GetBoo('SvMirrorVert');
      DDD.SvColorFactor    := GetD  ('SvColorFactor' );     {30.07.97 P.W}
      If DDD.SvColorFactor<=0 then DDD.SvColorFactor:=1;    {30.07.97 P.W}
    {----------------------------------------------------------------}
  end;
  SetupIni.Done;
  If (Res>0) then Res:=0; {!}
  ReadDevTypRec:=Res;
end;

