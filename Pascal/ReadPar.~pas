function AdcToTempCelsius(ADC: Integer; PTIR: pTempIniRec=nil;ForceValid:Boolean=False): Single;
// 09.07.08 P.W
// Modifications:
// 27.04.09 P.W:
//  a) when Device Entry does not support XRayThermometer then return Temperature_SensorDisabled
//  b) New Parameter ForceValid for use by calculations where no device is connected
//
var
  I : Integer;
  Pot : Double;
begin
  if PTIR = nil then PTIR := @GlbTempIni;

  if (not ForceValid) and (not GlbEE_Param_DeviceOptions.XRayThermometer) then  // 27.04.09 P.W
  begin
    if GlbEE_Param_DeviceOptions.Valid then
    begin
      Result := Temperature_SensorDisabled;
    end else
    begin
      Result := Temperature_SensorUnknownState;
    end;
    EXIT;
  end;

  // Special values:
  if ADC = $0000 then
  begin
    Result := Temperature_NoBoard;
    EXIT;
  end else
  if ADC = $03FF then
  begin
    Result := Temperature_NoSensor;
    EXIT;
  end else
  if ADC < PTIR.ADCmin then
  begin
    Result := Temperature_ADCBelowRange;
    EXIT;
  end else
  if ADC > PTIR.ADCmax then
  begin
    Result := Temperature_ADCAboveRange;
    EXIT;
  end;

  if PTIR.Valid then
  begin
    ADC := EnsureRange(ADC, PTIR.ADCmin, PTIR.ADCmax);
    Result := 0;
    Pot := 0.1;
    for I := Low(PTIR.aI) to High(PTIR.aI) do
    begin
      Result := Result +  PTIR.aI[I] * Pot;
      Pot    := Pot * ADC;
    end;
  end else
  begin
    Result := Temperature_InvalidPar;
  end;
end;

