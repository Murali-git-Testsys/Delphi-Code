    {----------------------------------------------------------------}
    My_Section:='[DEVICETYPE ' + _Name + ']';
    { $ V - }  {23.07.03 P.W: remove "V-"}
      If Search(My_Section, 'DEVICENAME',  ValStr) >= 0 Then
         DDD.DeviceName := ValStr; {23.07.03 P.W: remove "V-"}
