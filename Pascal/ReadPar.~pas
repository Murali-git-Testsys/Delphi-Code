Function  SaveXPosMinMax (XPosMin, XPosMax: Double; MsgFlg:Boolean=True): Smallint;
// 25.05.05 P.W
// Caller should support adaption of Measurement masks by call of DefSnr_Masks.exe
// See UfrmTools.pas Edit Device.snr
// Modifications:
// 21.06.05 P.W: Support MeasDiameterMin/Max/Def and GlbCalcMeasDiameterMax
Var
  Res              : Smallint;
  SetupIni         : tSetupIni;
begin  {Func. SaveXPosMinMax}
  Res:=0;

  // v--- adapt MeasDiameter* s. 21.06.05 P.W
  // Calculations:
  GlbDevSnr.XPosMin := XPosMin;  // needed by GlbCalcMeasDiameterMax
  GlbDevSnr.XPosMax := XPosMax;  // needed by GlbCalcMeasDiameterMax
  GlbDevSnr.MeasDiameterMax := GlbCalcMeasDiameterMax;

  GlbDevSnr.MeasDiameterMin :=  // min not above max
    Min(GlbDevSnr.MeasDiameterMin, GlbDevSnr.MeasDiameterMax);
  GlbDevSnr.MeasDiameterDef :=  // def not above max
    Min(GlbDevSnr.MeasDiameterDef, GlbDevSnr.MeasDiameterMax);
  GlbDevSnr.MeasDiameterDef :=  // def not below min
    Max(GlbDevSnr.MeasDiameterDef, GlbDevSnr.MeasDiameterMin);
  // ^--- adapt MeasDiameter* s. 21.06.05 P.W

  SetupIni.Init(LocDevSnrFile);
  With SetupIni Do
  begin
    ErrorHaltFlg:=False;

    If (Res=0) then Res:=
      Modify('[Measurement]', 'XPosMin', InvValD(XPosMin,10, 3));
    If (Res>0) then Res:=0;

    If (Res=0) then Res:=
      Modify('[Measurement]', 'XPosMax', InvValD(XPosMax,10, 3));
    If (Res>0) then Res:=0;

  // v--- adapt MeasDiameter* s. 21.06.05 P.W
    If (Res=0) then Res:=
      Modify('[Measurement]', 'MeasDiameterMin', InvValD(GlbDevSnr.MeasDiameterMin,10, 3));
    If (Res>0) then Res:=0;

    If (Res=0) then Res:=
      Modify('[Measurement]', 'MeasDiameterMax', InvValD(GlbDevSnr.MeasDiameterMax,10, 3));
    If (Res>0) then Res:=0;

    If (Res=0) then Res:=
      Modify('[Measurement]', 'MeasDiameterDef', InvValD(GlbDevSnr.MeasDiameterDef,10, 3));
    If (Res>0) then Res:=0;
  // ^--- adapt MeasDiameter* s. 21.06.05 P.W

    If (Res=0) then Res:=
      Write;
  end;
  SetupIni.Done;
//ReadGlbDevSnrRec; no longer neccessary // 21.06.05 P.W
  Result := Res;
  if MsgFlg then
  ShowMessageFmt(
    'XPosMin: %6.2f and XPosMax: %6.2f saved in "Device.snr".'+sLineBreak+
    'MeasDiameterMax is %6.2f [mm]'+sLineBreak+
    sLineBreak+
    'MeasDiameterMax depends on OffsetCenterMm and must be adapted again'+sLineBreak+
    'when OffsetCenterMm has been changed!',
    [XPosMin,
     XPosMax,
     GlbDevSnr.MeasDiameterMax
    ]);
end;   {Func. SaveXPosMinMax}

