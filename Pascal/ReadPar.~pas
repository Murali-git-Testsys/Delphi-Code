// 09.07.08 P.W
  function TempMsgFstPart: AnsiString;
  // 02.10.09 P.W   mark the option that temperature is protocolled but not used for pause
  begin
    if GlbDevSnr.UseTempPause then
      Result := 'T.:'
    else
      Result := '<t>';
  end;
begin
  If (Round(TempCelsius) >= Temperature_ErrCodeMin) then
  begin
    case Round(TempCelsius) of
      Temperature_ADCBelowRange:      Result := 'Temp. ADC below min!';
      Temperature_InvalidPar:         Result := 'Temp. parameter invalid!';

      Temperature_SensorUnknownState: Result := 'Temp. status unknown!';   // 27.04.09 P.W
      Temperature_SensorDisabled:     Result := 'Temp. sensor disabled!';  // 27.04.09 P.W

      Temperature_NoSensor:           Result := 'Temp. sensor missing!';
      Temperature_NoBoard:            Result := 'Temp. board missing!';
      Temperature_ADCAboveRange:      Result := 'Temp. ADC above max!'
      else                            Result := 'Temp. sensor error!'
    end;
  end else
  begin
    if PTIR = nil then PTIR := @GlbTempIni;

    if (Abs(ReadSeconds) >= 10 * Temperature_ReadSecOld) then
    begin
      Result := Format('%s(--.-)ºC',  [TempMsgFstPart, TempCelsius]);
      EXIT;
    end else
    if (Abs(ReadSeconds) >= Temperature_ReadSecOld) then
      Result := Format('%s(%4.1f)ºC', [TempMsgFstPart, TempCelsius])
    else
      Result := Format('%s %4.1f ºC', [TempMsgFstPart, TempCelsius]);

    if TempCelsius >= PTIR.TempMax     then Result := Result + ' '+Tras('above max.!') else
    if TempCelsius >= PTIR.TempWarning then Result := Result + ' '+Tras('high!') ;
  end;

end;

procedure TestAdcToCelsius(PTIR: pTempIniRec=nil; TestName:AnsiString='');
// 09.07.08 P.W
var
  SL : TStringList;
  ADC : Integer;
  Len, I, DLen : Integer;
begin
  if PTIR = nil then PTIR := @GlbTempIni;
  if TestName = '' then TestName := LocInterDir+'TestAdcToCelsius.txt';
  SL := TStringList.Create;

  SL.Append(Format('ADCmin = %5d', [PTIR.ADCmin]));
  SL.Append(Format('ADCmax = %5d', [PTIR.ADCmax]));
  SL.Append('');

  for I := Low(PTIR.aI) to High(PTIR.aI) do
    SL.Append(Format('a%d = %1.8g', [I, PTIR.aI[I]]));

  SL.Append('');

  SL.Append('ADC'#9'Temp (ºC)');
  Len :=  PTIR.ADCmax - PTIR.ADCmin +1;
  DLen := Len div 20;
//  for ADC := 0 to $3FFF do
  for ADC := PTIR.ADCmin-DLen to PTIR.ADCmax+DLen do
  begin
    SL.Append(Format('%5d'#9'%7.2f', [ADC, AdcToTempCelsius(ADC, PTIR, True)]));
  end;
  SL.SaveToFile(TestName);
  SL.Free;
end;

function IsTempIniRecValid(const TIR: tTempIniRec): Boolean;
// 09.07.08 P.W
  function ChkSum: Double;
  var
    I : Integer;
  begin
    Result := 0;
    for I := Low(TIR.aI) to High(TIR.aI) do
      Result := Result + Power(1000, I-1) * TIR.aI[I];
  end;
begin
  Result := (TIR.Chk_DebugName <> '');
  if Result then
  begin
    Result := (abs(TIR.aC - ChkSum) < 1e-5);
    if not Result then
    begin
      if ServiceFlg then
      begin
        ReadlnHalt(1, Format('Value of aC in %s is not valid! Expected: %8.6f', [TIR.Chk_DebugName, ChkSum]));
      end else
      begin
        ReadlnHalt(1, Format('Value of aC in %s is not valid!', [TIR.Chk_DebugName]));
      end;
    end;
  end;
end;

