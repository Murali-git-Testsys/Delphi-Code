Function  StoreDetRecPartMeas (
           Const Name: PathStr; Var Buf; Size, RelPos: Word): Smallint;
Var
  Res, ResH        : Smallint;
  Io               : File;
  WritePos         : LongInt;
begin  {Func. StoreDetRecPartMeas}
  Res:=FileOpen(Io, Name);  {opens existing file!}
  WritePos:=SizHeadPart1 + RelPos;
  If (Res=0) then Res:=FilePosWrite(Io, WritePos, Buf, Size);
  ResH:=FileClose(Io);         {Close ever!}
  If (Res=0) then Res:=ResH;

  StoreDetRecPartMeas:=Res;
//ShowMessageFmt('Debug "%s" ReadPar.pas StoreDetRecPartMeas: "%s"; Size:%d; RelPos:%d ', [Param_Str(0), Name, Size, RelPos]);
