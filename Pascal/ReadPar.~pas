Function  ReadHvLogFile: Smallint;
Var
  Res            : Smallint;
  SetupIni       : TSetupIni;
  Ctr            : Smallint;
  Axis             : Char;
begin  {Func. ReadHvLogFile}
  Res:=0;
  SetupIni.Init(HvLogFile);
  With SetupIni Do
  begin
    ErrorHaltFlg:=False;  {17.06.97 P.W} {allow missing HvLogFile}

    My_Section:='[HV]';
    HvHours := GetD('HvHours');
    FillChar(HvLastSeconds, SizeOf(HvLastSeconds), #0);
    {Shift by loading: HvLastSeconds[2]:=HvLastSeconds_1}
    For Ctr:=2 to MaxHvLastSeconds do
      HvLastSeconds[Ctr]:= GetD('HvLastSeconds_'+InvVal(Ctr-1, 1) );
    TotalRetryHvCtr     := GetL('TotalRetryHvCtr');
    TotalRetryHvFailCtr := GetL('TotalRetryHvFailCtr');          // 12.11.09 P.W
    TotalSliceCtr       := GetL('TotalSliceCtr');                // 12.11.09 P.W



    HvSecondsSinceStartOffs    := GetD('HvSecondsSinceStart');   // 23.11.07 P.W
    HvSecondsSinceStartCurrent := HvSecondsSinceStartOffs;       // 23.11.07 P.W

    My_Section:='[DISTANCES]';
    FillChar(LogMotDistMm, SizeOf(LogMotDistMm), #0);
    For Axis:=AxisFirst to AxisLast do
      LogMotDistMm[Axis]:= GetD('LogMotDistMm_'+Axis );

    My_Section:='[CHECK]';    // 12.11.09 P.W
    TotalCheckEncoderCtrX     := GetL('TotalCheckEncoderCtrX');

    My_Section:='[RETRY]';    // 12.11.09 P.W
    TotalPosReInitCtr         := GetL('TotalPosReInitCtr');
    TotalPosRecoverCtrX       := GetL('TotalPosRecoverCtrX');
    TotalPosRecoverCtrY       := GetL('TotalPosRecoverCtrY');
    TotalPosRecoverCtrZ       := GetL('TotalPosRecoverCtrZ');

    My_Section:='[FAIL]';    // 12.11.09 P.W
    TotalCheckEncoderFailCtrX := GetL('TotalCheckEncoderFailCtrX');
    TotalPosReInitFailCtr     := GetL('TotalPosReInitFailCtr');
    TotalPosRecoverFailCtrX   := GetL('TotalPosRecoverFailCtrX');
    TotalPosRecoverFailCtrY   := GetL('TotalPosRecoverFailCtrY');
    TotalPosRecoverFailCtrZ   := GetL('TotalPosRecoverFailCtrZ');

    TotalLightbarFailCtrX     := GetL('TotalLightbarFailCtrX');
    TotalLightbarFailCtrY     := GetL('TotalLightbarFailCtrY');
    TotalLightbarFailCtrZ     := GetL('TotalLightbarFailCtrZ');

  end;
  SetupIni.Done;
  If (Res>0) then Res:=0;
  ReadHvLogFile:=Res;
end;   {Func. ReadHvLogFile}

