(** Function Name    : GetDevTypPtr                                       **)
(** Author           : P.Wueseke                                          **)
(** Date             : 02.12.96                                           **)
(** Description      : Checks if the desired DevTypRec is loaded.         **)
(** Description      : If not: Load the DevTypRec to memory, register it  **)
(** Description      : Ever: Set the DevTypPtr to the DevTypRec in memory **)
(** Description      : Attention! DevTypPtr does not possess the data!    **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : pDevTypEntry.Init                                  **)
(** Input            : DevTypPtr, _Name                                   **)
(** Output           : DevTypPtr                                          **)
(** Output           : RETURN (Smallint): Ok: Ret=0; not Ok: Ret=ErrCode;  **)
(** Global Variables                                                      **)
(**  - affected      : GlbDevTypList                                      **)
(**  - predefined    : -                                                  **)
(***************************************************************************)
(** Last modified/By : 06.03.97 / P.Wueseke                               **)
(** Date/Modification: 06.03.97 P.W / if _name is empty use:              **)
(** Date/Modification: 06.03.97 P.W + GlbGlobalIniRec.OldDeviceTyp_X      **)
(**************************************************************************.*)
Function  GetDevTypPtr (Var DevTypPtr: pDevTypRec; _Name: String12): Smallint;
Var
  Res              : Smallint;
  Ctr              : Smallint;
  Found            : Boolean;
begin  {Func. GetDevTypPtr}
  Res:=0;
  If _Name='' then _Name:=GlbGlobalIniRec.OldDeviceTyp_X; {06.03.97 P.W}
  DevTypPtr:=Nil;
  With GlbDevTypList^ do
  begin
    Found:=False;
    Ctr:=0;
    While (Ctr<Count) and (not Found) do
    begin
      Found := (pDevTypEntry(At(Ctr))^.E_DevTyp=_Name);
      if not Found then Inc(Ctr);
      {!! use ctr 10.02.97 P.W}
    end;
    If (not Found) then
    begin
      Insert(New(pDevTypEntry, Init(_Name)));
//      Found:=True;
      {!! use ptr direct!!10.02.97 P.W} {sorted list will not work!}
    end;
    DevTypPtr:=pDevTypEntry(At(Ctr))^.E_DevTypPtr;
  end;
  If (Res=0) and (DevTypPtr=Nil) then Res:=-1;
  GetDevTypPtr:=Res;
end;   {Func. GetDevTypPtr}

