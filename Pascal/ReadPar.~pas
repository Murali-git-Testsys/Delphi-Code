(** Input            : _Name                                              **)
(** Output           : DDD: tDevSnrRec                                    **)
(** Output           : RETURN (Smallint): Ok: Ret=0; not Ok: Ret=ErrCode;  **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : LocDevSnrFile                                      **)
(***************************************************************************)
(** Date/Modification: 10.12.96 P.W / Support SelectedDevType, MechPar    **)
(** Date/Modification: 21.01.97 P.W / Add "HvTimeOut", "MotorTimeOut"     **)
(** Date/Modification: 28.05.97 P.W / New: UseScanStep, UseEpr135         **)
(** Date/Modification: 10.06.97 P.W / Sup. LiDiffVal_X\Y\Z                **)
(** Date/Modification: 16.06.97 P.W / Sup. PosPostSV\CT                   **)
(** Date/Modification: 24.06.97 P.W / TubeCurrentMa -> sect. SelDevTyp    **)
(** Date/Modification: 01.10.01 P.W / HvTimeOut -> HvTimeOutMax           **)
//05.03.09 P.W: Corrected: "BoardTemp" sets BoardTemp and no longer TempProt.
{23.07.03 P.W: remove "V-"}
(**************************************************************************.*)
Function  ReadGlbDevSnrRec: Smallint;  {18.07.97 P.W to enclose ReadDevSnrRec}
  Function  ReadDevSnrRec(Var DDD: tDevSnrRec; _Name: PathStr): Smallint;
  Var
    Res, ResH      : Smallint;
    SetupIni       : TSetupIni;
    ValStr         : String;
//  IDStr          : String;
//  Ctr            : Word;
    Err            : LongInt;
    Axis           : Char;      {10.06.97 P.W}
    H_LiDiffVal    : LongInt;   {10.06.97 P.W}
    H_PosPost      : Single;    {16.06.97 P.W}
    H_Bool         : Boolean;   {18.10.02 P.W}
  begin {Func. ReadDevSnrRec}
    Res:=0;
    FillChar(DDD, SizeOf(DDD), #0);
    SetupIni.Init(_Name);
    DDD.Chk_DebugName:= FExpand(SetupIni.Name);   {06.08.97 P.W}
    With SetupIni Do
    begin
      ErrorHaltFlg:=True;  {17.06.97 P.W}
      { $ V - }  {23.07.03 P.W: remove "V-"}
      {----------------------------------------------------------------}
      {..\..\..\Inst\Dev\XCT2002.A\Device.Snr}
      My_Section:='[General]';
        If Search  (My_Section, 'ParamVers'    ,  ValStr) >= 0 Then
           DDD.ParamVers       := ValStr; {23.07.03 P.W: remove "V-"}

        If Search  (My_Section, 'SerialNo'     ,  ValStr) >= 0 Then
           DDD.SerialNo        := ValStr; {23.07.03 P.W: remove "V-"}

        If Search  (My_Section, 'EpromVersion' ,  ValStr) >= 0 Then
          DDD.EpromVersion     := ValStr; {23.07.03 P.W: remove "V-"}

        {v--- 19.07.02 P.W}
        FirmWareVers := DDD.EpromVersion;
        VF_VersNo := FirmWareNoFromVers(DDD.EpromVersion);
          {^-- to allow correct calculation of BaudRate when FirmWare
               version has not been read during connect to device}


        {^--- 19.07.02 P.W}
        If Search  (My_Section, 'EpromType'    ,  ValStr) >= 0 Then
           DDD.EpromType       := ValStr; {23.07.03 P.W: remove "V-"}

        If Search  (My_Section, 'SelectedDevType',ValStr) >= 0 Then {10.12.96 P.W}
           DDD.SelectedDevType := ValStr; {23.07.03 P.W: remove "V-"}

      {---------------------------------------}
      {--- 10.11.00 P.W ---}
      ErrorHaltFlg:=False;
        If Search  (My_Section, 'DbHeaderPlus' ,  ValStr) >= 0 Then
           DDD.DbHeaderPlus    := ValStr; {23.07.03 P.W: remove "V-"}
      ErrorHaltFlg:=True;
      {--------------------}
      {----------------------------------------------------------------}
      // 09.07.08 P.W
      ErrorHaltFlg:=False;

      My_Section:='[XrayTemp]';

           DDD.TempEnabled  := GetBoo('Enabled');   // "Enable" -> "Enabled": 19.12.08 P.W

           DDD.UseTempPause := GetBoo('UseTempPause', DDD.TempEnabled); // 02.10.09 P.W
      ErrorHaltFlg := DDD.TempEnabled;

           DDD.TempProt     := GetBoo('Prot');

        If Search  (My_Section, 'Type'    ,  ValStr) >= 0 Then
           DDD.TempIni      := ValStr;

           DDD.BoardTemp    := GetBoo('BoardTemp'); // 19.12.08 P.W
                   // 05.03.09 P.W: Set BoardTemp and no longer TempProt

      ErrorHaltFlg:=True;
      {----------------------------------------------------------------}
      {10.12.96 P.W:}
      My_Section:='[' + DDD.SelectedDevType + ']';
        If Search  (My_Section, 'DeviceTyp'    ,  ValStr) >= 0 Then
           DDD.DeviceTyp       := ValStr; {23.07.03 P.W: remove "V-"}

        If Search  (My_Section, 'MechPar'      ,  ValStr) >= 0 Then
           DDD.MechPar         := ValStr; {23.07.03 P.W: remove "V-"}

        {--------------------------------------------------------------}
      {$V+}
        {24.06.97 P.W} {from section [Measurement]}
        DDD.TubeCurrentMA    := GetD  ('TubeCurrentMA'      );
        DDD.TubePotentialKV  := GetD  ('TubePotentialKV'    );
        {--------------------------------------------------------------}
        {31.03.99 P.W}
        ErrorHaltFlg:=False;
          ResH:=Search(My_Section, 'SpikeLimitPerc',  ValStr);
            If ResH>=0 then
            begin
              Val(ValStr, DDD.SpikeLimitPerc, Err);
              If (Err <> 0)
                then DDD.SpikeLimitPerc:=SpikeLimitPerc_Def;
            end else DDD.SpikeLimitPerc:=SpikeLimitPerc_Def;
        ErrorHaltFlg:=True;
        {--------------------------------------------------------------}
        {--------------------------------------------------------------}
        {23.11.07 P.W}
        ErrorHaltFlg:=False;
          ResH:=Search(My_Section, 'EffDoseMySvPerMASec',  ValStr);
            If ResH>=0 then
            begin
              Val(ValStr, DDD.EffDoseMySvPerMASec, Err);
              If (Err <> 0)
                then DDD.EffDoseMySvPerMASec:=EffDoseMySvPerMASec_Def;
            end else DDD.EffDoseMySvPerMASec:=EffDoseMySvPerMASec_Def;
        ErrorHaltFlg:=True;
        {--------------------------------------------------------------}
      {----------------------------------------------------------------}
      My_Section:='[Measurement]';
        DDD.HvTimeOutMax     := GetL  ('HvTimeOut'          ); {21.01.97 P.W}
                                       {^- Name inside Device.snr not changed!}
        DDD.MotorTimeOut     := GetL  ('MotorTimeOut'       ); {21.01.97 P.W}
        {--------------------------------------------------------------}
        {15.04.99 P.W}
        ErrorHaltFlg:=False;

          ResH:=Search(My_Section, 'IdleTimeOut',  ValStr);
