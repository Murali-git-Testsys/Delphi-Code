(** Called By        : any                                                **)
(** Calls            : -                                                  **)
(** Input            : Name (Name of file containing DetRec)              **)
(** Output           : Ok:Ret=0; not Ok:Ret=ErrCode                       **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : -                                                  **)
(***************************************************************************)
(** Last modified/By : 15.09.97 / P.Wueseke                               **)
(** Date/Modification: 06.12.96 P.W / FillChar(DR)                        **)
(** Date/Modification: 06.08.97 P.W / Sup. GlbDetRec_Chk_DebugName        **)
(** Date/Modification: 15.09.97 P.W / Set Recsize valid                   **)
(**************************************************************************.*)
Function  LoadDetRec(Const Name: PathStr; Var DR: DetRecType): Smallint;
Var
  Res, ResH        : Smallint;
  IO               : File of DetRecType;
begin
  Res:=0;
  FillChar(DR, SizeOf(DR), #0);  {06.12.96 P.W}
  {$I-}
    If Addr(DR)=Addr(GlbDetRec) then   {06.08.97 P.W}
      GlbDetRec_Chk_DebugName:=FExpand(Name);    {06.08.97 P.W}

    Assign(IO, FExpand(Name)); // FExpand added (03.03.04 P.W)
    ResH:=IoResult; If (Res=0) then Res:=ResH;
    if Res=0 then Reset(IO);
    ResH:=IoResult; If (Res=0) then Res:=ResH;
    if Res=0 then Read(IO, DR);
    ResH:=IoResult; If (Res=0) then Res:=ResH;
    Close(IO);
  {$I+}
  DR.RecSize:=SizeOf(DR);   {15.09.97 P.W}
  ResH:=IoResult; If (Res=0) then Res:=ResH;
  LoadDetRec:=Res;
end;

