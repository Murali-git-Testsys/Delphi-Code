Procedure ErrHalt(Res: Smallint; Msg1, Msg2: String);
begin
  { until  25.08.09 P.W:
  ClrScr;
  Writeln('Error (',Res,'), ', Msg1);   
  Writeln('  ', Msg2);
  Writeln('   Please press enter to abort...');
  // --- one of the exit-procedures seems to call ClrScr, so we set: ---
  Window(1, 10, 80, 25);   // 03.06.97 P.W
