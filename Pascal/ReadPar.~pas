function CalcMeasDiameterMax(XMin, XMax, DSC, Offs, ThDA, ThDB: Double): Double;
// 31.05.05 P.W
var
//AddV,    // AddValue: used to accellerate added at start and end
           // of motion
//XMin,    // Minimal X Position + AddV
//XMax,    // Maximal X Position - AddV
//DSC,     // Distance XRaySpot to Center of Rotation (CoR)
//Offs,    // perpendicular projection of Center of Rotation to X Axis
           // "OffsetCenter"
//ThDA,    // Angle between perpendicular of X Axis of forward looking Detector
//ThDB,    // as ThetaD1 for backward looking detector
           // ThetaD1 is checked agains XMin and ThetaD2 again XMax
  //----------------------------------------------------
  PhiA,    // ThDA + PhiA = 90 deg
  PhiB,    // ThDB + PhiB = 90 deg
  RadA,    // Distance CoR to Ray to Detector DA from XMin
  RadB,    // Distance CoR to Ray to Detector DB from XMax

//XA,      // Projection of CoR to X under ThDA
//XB,      // Projection of CoR to X under ThDB
  XRadA,   // XA - XMin: Projection of RadA to X
  XAO,     // Offs - XA
  XRadB,   // XMax - XB:  Projection of RadB to X
  XBO      // XB - Offs
    : Double;
  //           |             /.
  //           |           /      .  CoR
  //           |         /     RadA  .+
  //           |       /            / |
  //           |ThDA /            /   | DSR
  //           |   /            /     |
  //           | / PhiA       /       |
  //        ---+------------+---------+-----------------------+---> X
  //          XMin         XA        Offs                    XMax
  //           |            |         |
  //           |   XRadA    |  XAO    |
  //
  //  Result is MeasdiameterMax the maximal possible measdiameter
  //    if found as 2.0 * Minimum(RadA, RadB);
  //  Geometrical rules:
  //  1)   DSC  / XA0   = Tan(PhiA)  = Sin(PhiA) / Cos(PhiA)
  //  2)   RadA / XRadA = Sin (PhiA);
  //  Look out PhiA may be 90 deg (but never zero)!
begin
  PhiA   := DegToRad(90) - ThDA;
  PhiB   := DegToRad(90) - ThDB;
  XAO    := DSC * Cos(PhiA) / Sin(PhiA);  // valid for 90 deg! {DSC / Tan(Phi) is not valid!}
  XBO    := DSC * Cos(PhiB) / Sin(PhiB);  // valid for 90 deg! {DSC / Tan(Phi) is not valid!}
  XRadA  := Offs - XMin - XAO;
  XRadB  := XMax - Offs - XBO;
  RadA   := XRadA * Sin(PhiA);
  RadB   := XRadB * Sin(PhiB);
  // ---------------------------------------
  Result := 2.0 * Math.Min(RadA, RadB);
  Result := Result - 0.5;  // take into account that MeasDiameter is
                           // only accurate +- 0.5*voxelsize!
end;

function GlbCalcMeasDiameterMax: Double;
// 31.05.05 P.W
var
  AddV,    // AddValue: used to accellerate; added at start and end
           // of motion
  XMin,    // Minimal X Position + AddV
  XMax,    // Maximal X Position - AddV
  DSC,     // Distance XRaySpot to Center of Rotation (CoR)
  Offs,    // perpendicular projection of Center of Rotation to X Axis
           // "OffsetCenter"
  ThDA,    // Angle between perpendicular of X Axis of forward looking Detector
  ThDB     // as ThetaD1 for backward looking detector
   :Double;// ThetaD1 is checked agains XMin and ThetaD2 again XMax
begin

  AddV   := GlbDetRec.AddValueMm;
  XMin   := GlbDevSnr.XPosMin + AddV;
  XMax   := GlbDevSnr.XPosMax - AddV;
  DSC    := GlbDetRec.DistSourceCenter;
  Offs   := GlbDetRec.OffSetCenterMm;
  ThDA   := DegToRad(GlbDetRec.Theta_Det1);
  ThDB   := DegToRad(GlbDetRec.Theta_Det1 +
                       (GlbDetRec.NumDet -1) *
                       GlbDetRec.Delta_Theta *
                       GlbDetRec.DetDir);

  // ignore possible slight asymmetrie and do not worry
  // which detector looks forward, which backward:
  ThDA := Math.Max(Abs(ThDA), Abs(ThDB));
  ThDB := THDA;

  Result := CalcMeasDiameterMax(XMin, XMax, DSC, Offs, ThDA, ThDB);
end;

