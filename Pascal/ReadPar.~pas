(** Function Name    : WriteHvLogFile                                      **)
(** Author           : P.Wueseke                                          **)
(** Date             : 15.11.96                                           **)
(** Description      :                                                    **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : tSetUpInit: Init, Modify, Write, Done              **)
(** Input            : -                                                  **)
(** Output           : RETURN (Smallint): Ok: Ret=0; not Ok: Ret=ErrCode;  **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : HvHours                                            **)
(***************************************************************************)
(** Last modified/By : 14.06.99 / P.Wueseke                               **)
(** Date/Modification: 29.11.96 P.W / Support HvLastSeconds               **)
(** Date/Modification: 14.06.99 P.W / Support LogMotDistMm                **)
// 23.11.07 P.W: Supp. HvSecondsSinceStart
(**************************************************************************.*)
Function  WriteHvLogFile: Smallint;
Var
  Res              : Smallint;
  SetupIni         : tSetupIni;
//ValStr           : String;
  Ctr              : Smallint;
  Axis             : Char;
//Err              : Smallint;
begin  {Func. WriteHvLogFile}
  Res:=0;
  SetupIni.Init(HvLogFile);
  With SetupIni Do
  begin
    ErrorHaltFlg:=True;  {17.06.97 P.W}
    Modify('[HV]', 'HvHours', InvValD(HvHours,15, 4));
    For Ctr:=1 to MaxHvLastSeconds do
    begin
      Modify( '[HV]',
              'HvLastSeconds_'+InvVal(Ctr, 1),
               InvValD(HvLastSeconds[Ctr],15, 2));
    end;
    Modify('[HV]', 'TotalRetryHvCtr',     InvVal (TotalRetryHvCtr,         10));
    Modify('[HV]', 'TotalRetryHvFailCtr', InvVal (TotalRetryHvFailCtr,     10)); // 12.11.09 P.W
    Modify('[HV]', 'TotalSliceCtr',       InvVal (TotalSliceCtr,           10)); // 12.11.09 P.W

    Modify('[HV]', 'HvSecondsSinceStart', InvValD(HvSecondsSinceStartCurrent, 15, 2)); // 23.11.07 P.W


    For Axis:=AxisFirst to AxisLast do
    begin
      Modify('[DISTANCES]',
             'LogMotDistMm_'+Axis,
             InvValD(LogMotDistMm[Axis] ,12, 0));
    end;

    // v--- 12.11.09 P.W
    Modify('[CHECK]', 'TotalCheckEncoderCtrX',     InvVal (TotalCheckEncoderCtrX,     10));

    Modify('[RETRY]', 'TotalPosReInitCtr',         InvVal (TotalPosReInitCtr,         10));
    Modify('[RETRY]', 'TotalPosRecoverCtrX',       InvVal (TotalPosRecoverCtrX,       10));
    Modify('[RETRY]', 'TotalPosRecoverCtrY',       InvVal (TotalPosRecoverCtrY,       10));
    Modify('[RETRY]', 'TotalPosRecoverCtrZ',       InvVal (TotalPosRecoverCtrZ,       10));

    Modify('[FAIL]',  'TotalCheckEncoderFailCtrX', InvVal (TotalCheckEncoderFailCtrX, 10));
    Modify('[FAIL]',  'TotalPosReInitFailCtr',     InvVal (TotalPosReInitFailCtr,     10));
    Modify('[FAIL]',  'TotalPosRecoverFailCtrX',   InvVal (TotalPosRecoverFailCtrX,   10));
    Modify('[FAIL]',  'TotalPosRecoverFailCtrY',   InvVal (TotalPosRecoverFailCtrY,   10));
    Modify('[FAIL]',  'TotalPosRecoverFailCtrZ',   InvVal (TotalPosRecoverFailCtrZ,   10));

    Modify('[FAIL]',  'TotalLightbarFailCtrX',     InvVal (TotalLightbarFailCtrX,     10));
    Modify('[FAIL]',  'TotalLightbarFailCtrY',     InvVal (TotalLightbarFailCtrY,     10));
    Modify('[FAIL]',  'TotalLightbarFailCtrZ',     InvVal (TotalLightbarFailCtrZ,     10));
    // ^--- 12.11.09 P.W


  end;
  SetupIni.Write;
  SetupIni.Done;
  If (Res>0) then Res:=0;
  WriteHvLogFile:=Res;
end;   {Func. WriteHvLogFile}

