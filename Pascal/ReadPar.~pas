  ReadlnHalt(1);   // Halt -> ReadlnHalt: 01.10.00 P.W
  }
  // since 25.08.09 P.W:
  ReadlnHalt(1, Format('Error (%d), %s'+sLineBreak+'  %s', [Res, Msg1, Msg2]));
end;

Function  FirmWareNoFromVers(VersStr: String): LongInt; {19.07.02 P.W}
(*
Returns valid VersNo in range of 0..9999
   in case of error: returns -1
Format of VF: "XCT_t nnnn" t=type; nnnn= version;
          example: "XCT_H 1500"
*)
Var
  VersNo : LongInt;
  Err    : LongInt;
begin
  Val(Copy(VersStr,7,4), VersNo, Err);
  If (VersNo <    0) then VersNo := 0
  else
  If (VersNo > 9999) then VersNo := 9999;
  If (Err<>0) then VersNo := -1;
  FirmWareNoFromVers := VersNo;
end;

