(** Function Name    : MeasGrpNo                                          **)
(** Author           : P.Wueseke                                          **)
(** Date             : 22.05.95                                           **)
(** Description      : Calculates the measgroup of the slice "SliceNo"    **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : -                                                  **)
(** Input            : Const, HR, SliceNo, SliceNoGrp                     **)
(** Output           : SliceNoGrp                                         **)
(** Output           : RETURN (Word): WRet                                **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : -                                                  **)
(***************************************************************************)
(** Last modified/By : -                                                  **)
(** Date/Modification: -                                                  **)
(**************************************************************************.*)
Function MeasGrpNo(Const HR: THeadRec; SliceNo: Word;
           Var SliceNoGrp: Word): Word;
{MeasGrpNo=0 : Invalid SliceNo}
Var
  Grp              : Word;
  Sum              : Word;
begin {Funct MeasGrpNo}
  With HR do
  begin
    Grp:=0;
    Sum:=0;
    While (Sum<SliceNo) and (Grp<NumMeasGroups) do
    begin
      Inc(Grp);
      With MeasGrpArr[Grp] do
      begin
        Inc(Sum, NumSlicesGrp);
      end; {With MeasGrpArr}
    end; {While}

    if (Sum<SliceNo) then
    begin
      Grp:=0;
      SliceNoGrp:=0;
    end else
    begin
      SliceNoGrp:=SliceNo-(Sum-MeasGrpArr[Grp].NumSlicesGrp)
    end;
  end; {With HR}
  MeasGrpNo:=Grp;
end;  {Funct MeasGrpNo}

