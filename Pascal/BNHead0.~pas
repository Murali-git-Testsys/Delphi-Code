{!!! Imitiert von XBJob1.Pas WriteMeasXB MultiSlices!}
Var
  Grp              : Word;
  Sum              : Word;
begin
  Sum:=0;
  With HR do
  For Grp:=1 to NumMeasGroups do
    Inc(Sum, MeasGrpArr[Grp].NumSlicesGrp);
  MultiSlices:=Sum;
end;

