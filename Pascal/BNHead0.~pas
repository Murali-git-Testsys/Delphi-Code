(** Structure Info   : "MeasGroups and ReferenceLines"                    **)
(** Author           : P.Wueseke                                          **)
(** Date             : 22.05.95                                           **)
(** Date             : -------------------------------------------------- **)
(** Date             : 12.10.96: Description valid for PercentFlg = True  **)
(** Date             : 12.10.96: If PercentFlg = False: PercDist serves   **)
(** Date             : 12.10.96: as Dist between RefLine and MeasPosGrp   **)
(** Date             : 12.01.96 P.W / Sign of PercDist inverted!          **)
(** Descripiton      : -------------------------------------------------- **)
(** Description      :  Describe up to MaxRefLine RefLines                **)
(** Description      :    and    up to MaxMeasGrp MeasGrp                 **)
(** Description      :  A reference line helps to find out the position   **)
(** Description      :  of a meas group using PatArmLen and the percent   **)
(** Description      :  rule of the meas group.                           **)
(** Description      :  The number of RefLines is given by NumRefLines    **)
(** Description      :  The total number of measgroups is given by        **)
(** Description      :  NumMeasGroups. The conection between MeasGrp      **)
(** Description      :  and Relines is established by MeasGrp.RefLineNo   **)
(** Description      :  The minimum number is one Refline and one MeasGrp **)
(** Description      :  There may be up to MaxMeasGrp MeasGroups conected **)
(** Description      :  to one Refline if ther is only one Refline        **)
(** Description      :  One MeasGrp may be a "single Slice" or a "Multiple**)
(** Description      :  Slice" with its own percentrule and slicedistance **)
(** Description      :                                                    **)
(** Examples         :  ================================================= **)
(** Example 1        :  PatArmLen                     = 200    [mm]       **)
(** Example 1        :  NumMeasGroups                 =   1               **)
(** Example 1        :  NumRefLines                   =   1               **)
(** Example 1        :  RefLineArr[1]                 =  15    [mm]       **)
(** Example 1        :  MeasGrpArr[1].RefLineNo       =   1               **)
(** Example 1        :  MeasGrpArr[1].PercDist        =  -4.00 [%]        **)
(** Example 1        :  MeasGrpArr[1].NumSlicesGrp    =   4               **)
(** Example 1        :  MeasGrpArr[1].SliceDistGrp    =   1.0  [mm]       **)
(** Example 1        :  PercentFlg                    = True              **)
(** Example 1a       :  SlicesSymFlg                  = True              **)
(** Example 1b       :  SlicesSymFlg                  = False             **)
(** Example 1        :  ----------                                        **)
(** Example 1a+b     :  MeasPosGrpMm = 15mm-4%(200mm) =  (15-8)mm = 7mm   **)
(** Example 1a       :  With SlicesSymFlg = true we will receive          **)
(** Example 1a       :  following positions of measurement (Function      **)
(** Example 1a       :  MeasPosSliceMm) symmetric arround 7mm:            **)
(** Example 1a       :    SliceNo        Position [mm]                    **)
(** Example 1a       :       1              5.5                           **)
(** Example 1a       :       2              6.5                           **)
(** Example 1a       :       3              7.5                           **)
(** Example 1a       :       4              8.5                           **)
(** Example 1a       :                                                    **)
(** Example 1b       :  With SlicesSymFlg = false we will receive         **)
(** Example 1b       :  following positions of measurement (Function      **)
(** Example 1b       :  MeasPosSliceMm) symmetric arround 7mm:            **)
(** Example 1b       :    SliceNo        Position [mm]                    **)
(** Example 1b       :       1              7.0                           **)
(** Example 1b       :       2              8.0                           **)
(** Example 1b       :       3              9.0                           **)
(** Example 1b       :       4             10.0                           **)
(** Example 1b       :                                                    **)
(** Example 2        :  PatArmLen                     = 200    [mm]       **)
(** Example 2        :  NumMeasGroups                 =   2               **)
(** Example 2        :  NumRefLines                   =   2               **)
(** Example 2        :  RefLineArr[1]                 =  15    [mm]       **)
(** Example 2        :  RefLineArr[2]                 =  30    [mm]       **)
(** Example 2        :  MeasGrpArr[1].RefLineNo       =   1               **)
(** Example 2        :  MeasGrpArr[1].PercDist        =  -4.00 [%]        **)
(** Example 2        :  MeasGrpArr[1].NumSlicesGrp    =   4               **)
(** Example 2        :  MeasGrpArr[1].SliceDistGrp    =   1.0  [mm]       **)
(** Example 2        :  MeasGrpArr[2].RefLineNo       =   2               **)
(** Example 2        :  MeasGrpArr[2].PercDist        =  -2.00 [%]        **)
(** Example 2        :  MeasGrpArr[2].NumSlicesGrp    =   3               **)
(** Example 2        :  MeasGrpArr[2].SliceDistGrp    =  -0.1  [mm]       **)
(** Example 2        :  PercentFlg                    = True              **)
(** Example 2        :  SlicesSymFlg                  = False             **)
(** Example 2        :  ----------                                        **)
(** Example 2        :  MeasPosGrpMm[1]= 15mm-4%(200mm) = (15-8)mm =  7mm **)
(** Example 2        :  MeasPosGrpMm[2]= 30mm-2%(200mm) = (30-4)mm = 26mm **)
(** Example 2        :  With SlicesSymFlg = false we will receive         **)
(** Example 2        :  following positions of measurement (Function      **)
(** Example 2        :  MeasPosSliceMm)                                   **)
(** Example 2        :    SliceNo        Position [mm]    MeasGrp         **)
(** Example 2        :       1              7.0              1            **)
(** Example 2        :       2              8.0              1            **)
(** Example 2        :       3              9.0              1            **)
(** Example 2        :       4             10.0              1            **)
(** Example 2        :       5             26.0              2            **)
(** Example 2        :       6             25.9              2            **)
(** Example 2        :       7             25.8              2            **)
