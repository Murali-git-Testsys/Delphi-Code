(** Function Name    : ReadHead                                           **)
(** Author           : P.Wueseke                                          **)
(** Date             : 27.07.95                                           **)
(** Description      : BlockRead of Head to File                          **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : Assign, Reset, BlockRead, Close                    **)
(** Input            : Name                                               **)
(** Output           : Head                                               **)
(** Output           : RETURN (Smallint): Ok: Ret=0; not Ok: Ret=ErrCode;  **)
(** Global Variables                                                      **)
(**  - affected      : ?                                                  **)
(**  - predefined    : ?                                                  **)
(***************************************************************************)
(** Last modified/By : -                                                  **)
(** Date/Modification: -                                                  **)
(**************************************************************************.*)
Function ReadHead(Var Head: THeadRec; Name: PathStr): Smallint;
Var
  Res, ResH        : Smallint;
  Readed           : LongInt; //Word;
  Inp              : File;
begin {Func. ReadHead}
  Res:=0;

  If (Res=0) then
  begin
  {$I-}
    Assign(Inp, FExpand(Name)); // FExpand added (04.03.04 P.W)
    ResH:=IoResult; If (Res=0) then Res:=ResH;
    If (Res=0) then
      Reset (Inp, 1);
    ResH:=IoResult; If (Res=0) then Res:=ResH;
    If (Res=0) then
      BlockRead(Inp, Head, SizeOf(Head), Readed);
    ResH:=IoResult; If (Res=0) then Res:=ResH;
    If (Res=0) and (SizeOf(Head)<>Readed) then Res:=Err_DiskRead;
    Close (Inp);
    ResH:=IoResult; If (Res=0) then Res:=ResH;
  {$I+}
  end;

  ReadHead:=Res;
end;  {Func. ReadHead}

(*.**************************************************************************)
(** Function Name    : WriteHead                                          **)
(** Author           : P.Wueseke                                          **)
(** Date             : 27.07.95                                           **)
(** Description      : BlockWrite of Head to File                         **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : Assign, Reset, BlockWrite, Close                   **)
(** Input            : Head, Name, WM                                     **)
(** Output           : RETURN (Smallint): Ok: Ret=0; not Ok: Ret=ErrCode;  **)
(** Global Variables                                                      **)
(**  - affected      : ?                                                  **)
(**  - predefined    : ?                                                  **)
(***************************************************************************)
(** Last modified/By : -                                                  **)
(** Date/Modification: -                                                  **)
(**************************************************************************.*)
Function WriteHead(Head: THeadRec; Name: PathStr; WM: W_Mode): Smallint;
Var
  Res, ResH        : Smallint;
  Written          : LongInt; //Word;
  Out              : File;
begin {Func. WriteHead}
  Res:=0;

  If (Res=0) then
  begin
  {$I-}
    Head.HeadSize:=SizeOf(Head);
    Assign(Out, FExpand(Name)); // FExpand added (04.03.04 P.W)
    ResH:=IoResult; If (Res=0) then Res:=ResH;
    If (Res=0) then
    begin
      Case WM of
        W_READ:
          begin
            Res:=-1;
          end;
        W_OVERWRITE:
          begin
            Reset (Out, 1);
            ResH:=IoResult;
            if (ResH=Err_FileNotFound) then
            begin
              Rewrite(Out, 1);
              ResH:=IoResult; If (Res=0) then Res:=ResH;
            end else
            begin
              If (Res=0) then Res:=ResH;
            end;
          end;
        W_APPEND:
          begin
            Reset (Out, 1);
            ResH:=IoResult;
            if (ResH=0) then
            begin
              Seek(Out, FileSize(Out));
              ResH:=IoResult; If (Res=0) then Res:=ResH;
            end else
            if (ResH=Err_FileNotFound) then
            begin
              Rewrite(Out, 1);
              ResH:=IoResult; If (Res=0) then Res:=ResH;
            end else
            begin
              If (Res=0) then Res:=ResH;
            end;
          end;
        W_REWRITE:
          begin
            Rewrite (Out, 1);
            ResH:=IoResult; If (Res=0) then Res:=ResH;
          end;
      end;
    end;
    If (Res=0) then
    begin
      BlockWrite(Out, Head, SizeOf(Head), Written);
      ResH:=IoResult; If (Res=0) then Res:=ResH;
      If (Res=0) and (SizeOf(Head)<>Written) then Res:=Err_DiskWrite;
    end;
    Close (Out);
    ResH:=IoResult; If (Res=0) then Res:=ResH;
  {$I+}
  end;

  WriteHead:=Res;
end;  {Func. WriteHead}

