Function MeasPosGroupMm(Const HR : THeadRec; GroupNo: Word): Single;
begin {Func. MeasPosGroupMm}
  if (GroupNo>0) then
  begin
    With HR, MeasGrpArr[GroupNo] do
      if PercentFlg
      then MeasPosGroupMm:=RefArr[RefLineNo] + PatObjLen*PercDist*0.01
                                            {^ "-" --> "+": 12.01.96 P.W}
      else MeasPosGroupMm:=RefArr[RefLineNo] + PercDist;
  end else
  begin
      MeasPosGroupMm:=ErrValueFloat_;  {0 -> ErrV.:30.01.96 P.W}
  end;
end;  {Func. MeasPosGroupMm}

