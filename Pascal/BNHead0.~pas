(** Function Name    : MeasPosSliceMm                                     **)
(** Author           : P.Wueseke                                          **)
(** Date             : 22.05.95                                           **)
(** Description      : Calculates the position of slice "SliceNo"         **)
(** Description      : depending on: MeasPosGrpMm, SliceDistGrp,          **)
(** Description      :               SliceNoGrp, SlicesSymFlg             **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : MeasGrpNo, MeasPosGrpMm,                           **)
(** Input            : Const, HR, SliceNo                                 **)
(** Output           : RETURN (Single): DRet                              **)
(** Global Variables                                                      **)
(**  - affected      : -                                                  **)
(**  - predefined    : -                                                  **)
(***************************************************************************)
(** Last modified/By : 14.08.95 / P.Wueseke                               **)
(** Date/Modification: -                                                  **)
(** Date/Modification: 14.08.95 P.W / Use SliceSymFlg                     **)
(**************************************************************************.*)
Function MeasPosSliceMm(Const HR : THeadRec; SliceNo: Word): Single;
Var
  Grp              : Word;
  SliceNoGrp       : Word;
begin {Func. MeasPosSliceMm}
  Grp:=MeasGrpNo(HR, SliceNo, SliceNoGrp);
  if (Grp>0) then
  begin
    With HR, MeasGrpArr[Grp] do
    begin
      if SlicesSymFlg then  {14.08.95 P.W}
      begin
        MeasPosSliceMm:=MeasPosGroupMm(HR, Grp)+
                        (SliceNoGrp - 0.5 * (NumSlicesGrp+1)) * SliceDistGrp;
      end else
      begin                 {14.08.95 P.W}
        MeasPosSliceMm:=MeasPosGroupMm(HR, Grp)+
                        (SliceNoGrp - 1) * SliceDistGrp;
      end;
    end;
  end else
  begin
      MeasPosSliceMm:=ErrValueFloat_;  {0 -> ErrV.:30.01.96 P.W}
  end;
end;  {Func. MeasPosSliceMm}

