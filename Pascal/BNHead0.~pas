(** Function Name    : ChkAllSlicesZPosValid                              **)
(** Author           : P.Wueseke                                          **)
(** Date             : 29.08.95                                           **)
(** Description      : Check if all Slices are between MinZPosMm          **)
(** Description      : and MaxZPosMm (Tolerance: 0.1mm)                   **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : ?                                                  **)
(** Input            : HR, MinZPosMm, MaxZPosMm                           **)
(** Output           : RETURN: Ok: Ret=0; not Ok: Ret=1th invalid MeasGrp **)
(** Global Variables                                                      **)
(**  - affected      : ?                                                  **)
(**  - predefined    : ?                                                  **)
(***************************************************************************)
(** Last modified/By : -                                                  **)
(** Date/Modification: -                                                  **)
(**************************************************************************.*)
Function ChkAllSlicesZPosValid (Const HR: THeadRec;
           MinZPosMm, MaxZPosMm: Single): Smallint;
Const
  Tolerance        = 0.1;  {mm}
Var
  Res              : Smallint;
  HS               : Single;
  SliceNo          : Word;
  SliceNoGrp       : Word;
begin  {Func. ChkAllSlicesZPosValid}
  Res:=0;
  if (MinZPosMm>MaxZPosMm) then
  begin
    HS:=MaxZPosMm;
    MaxZPosMm:=MinZPosMm;
    MinZPosMm:=HS;
  end;
  MinZPosMm:=MinZPosMm-Tolerance;
  MaxZPosMm:=MaxZPosMm+Tolerance;
  For SliceNo:=1 to MultiSlices(HR) do
  if (Res=0) then
  begin
    HS:=MeasPosSliceMm(HR, SliceNo);
    if (HS < MinZPosMm) or (HS > MaxZPosMm) then
      Res:=MeasGrpNo(HR, SliceNo, SliceNoGrp);
  end;
  ChkAllSlicesZPosValid:=Res;
end;   {Func. ChkAllSlicesZPosValid}

