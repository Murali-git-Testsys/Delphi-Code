(**************************************************************************.*)
Function MeasRefPerc(Const HR : THeadRec; GroupNo: Word): Single;
begin
  if (GroupNo>0) then
  begin
    With HR, MeasGrpArr[GroupNo] do
    if PercentFlg
      then MeasRefPerc:=PercDist
      else
      If PatObjLen=0
      then MeasRefPerc:=ErrValueFloat_
      else MeasRefPerc:=100.0*(PercDist/PatObjLen);
  end else
  begin
    MeasRefPerc:=ErrValueFloat_;
  end;
end;

