  ok:=ok and (err=0) and (1<=MM) and (MM<=12);

  ht:=copy(txt,7,2);
  val(ht,JJ,err);
  ok:=ok and (err=0) and (0<=JJ) and (JJ<=99);

  ht:=copy(txt,1,2);
  val(ht,TT,err);
  if ok then
  begin
    ok:=(err=0) and (1<=TT) and (TT<=MonatsLetzter(MM,JJ));
  end;

  if not ok then Txt:= FT('TT.MM.JJ',FM,8) ;
  ValDatOk:=ok;
end;
