Function DateDescriptor(CountryCode:Word):String04;  {11.11.92 P.W}
{ MDY-  bedeutet: Month, Day, Year, Trennzeichen "-"  }
{       also    : MM-DD-YY                            }
begin
  Case CountryCode of
    001:                         DateDescriptor:='MDY-';
    002,036,038,042,046,048:     DateDescriptor:='YMD-';
    031,045,061:                 DateDescriptor:='DMY-';
    003,032,034,039,044,055,351: DateDescriptor:='DMY/';
    033,041,047,049,358:         DateDescriptor:='DMY.';
    else                         DateDescriptor:='DMY-';
  end;
end;

Function DateGerToInt(DGer:String08;CountryCode:Word):String08; {11.11.92 P.W}
Var
  Desc  : String04;
  DInt  : String08;
  P,i,j : Smallint;
begin
  Desc:=DateDescriptor(CountryCode);
  DInt[0]:=#8;
  DInt[3]:=Desc[4];
  DInt[6]:=Desc[4];
  for i:=1 to 3 do
  begin
    P:=(Pos(DateDescKey[i],Desc)-1)*3+1;
    j:=(i-1)*3+1;
    DInt[p  ]:=DGer[j  ];
    DInt[p+1]:=DGer[j+1];
  end;
  DateGerToInt:=DInt;
end;

