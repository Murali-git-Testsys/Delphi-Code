Function SecToDayHourMin (Sec: Comp): String;
Const
  SecArr    : Array[1..4] of Comp = ( 24*3600, 3600, 60, 1);
{  UnitArr   : Array[1..4] of String[12] = ('d', 'h', 'm', 's');}
Var
  DHMSArray : Array[1..4] of Comp;
Var
  SRet             : String;
  I                : Smallint;
  AddFlg           : Boolean;
  UnitName         : String[12];
begin  {Func. SecToDayHourMin}
  AddFlg:=False;
  SRet:='';
  For I:=1 to 4 do
  begin
    Case I of
      1: UnitName:=FT('d.=days',    FLP, 4);
      2: UnitName:=FT('h.=hours',   FLP, 4);
      3: UnitName:=FT('m.=minutes', FLP, 4);
      4: UnitName:=FT('s.=seconds', FLP, 4);
    end;
    UnitName:=StringParser(UnitName,'=',1);
    DHMSArray[I]:=Trunc(Sec / SecArr[I]);
    Sec:=Sec - DHMSArray[I] * SecArr[I];
    AddFlg := AddFlg or (I=4) or (DHMSArray[I]<>0);
    If AddFlg then
      SRet := SRet
              + InvValD(DHMSArray[I], 3, 0)
              + ' '
              + UnitName
              + FixSem
              +'';
  end;

  SecToDayHourMin:=SRet;
end;   {Func. SecToDayHourMin}

