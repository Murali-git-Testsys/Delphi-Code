Function AOlderB (A, B: LongInt): Boolean;
  Function TimeToDoub(Time: LongInt): Double;
  {Time increases until MaxLongInt and then goes negativ!}
  begin
    If (Time>=0) then TimeToDoub := 1.0 * Time
                 else TimeToDoub := 1.0 * Time + 2.0 * MaxLongInt;
  end;
begin  {Func. AOlderB}
  AOlderB := TimeToDoub(A) < TimeToDoub(B);
//ShowMessageFmt('CheckDat.pas function AOlderB(%d, %d) = %s', [A, B, BoolToStr(Result)]);
end;   {Func. AOlderB}


