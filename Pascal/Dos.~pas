(*  FindFirst, FindNext & FindClose
Delphi syntax:
function FindFirst(const Path: string; Attr: Integer; var F: TSearchRec): Integer;
------------------
Description
FindFirst searches the directory specified by Path for the
first file that matches the file name implied by Path and the
attributes specified by the Attr parameter. The result is
returned in the F parameter. Use the fields of this search
record to extract the information needed. FindFirst returns 0
if a file was successfully located, otherwise, it returns an
error code.
The Path constant parameter is the directory and file name mask,
including wildcard characters. For example, '.\test\*.*'
specifies all files in the current directory).
The Attr parameter specifies the special files to include in
addition to all normal files. Choose from these file attribute
constants when specifying the Attr parameter:

Constant	Description
faReadOnly	Read-only files
faHidden	Hidden files
faSysFile	System files
faVolumeID	Volume ID files
faDirectory	Directory files
faArchive	Archive files
faAnyFile	Any file
Attributes can be combined by adding (Delphi) or or-ing (C++)
their constants or values. For example, to search for read-only
and hidden files in addition to normal files, pass
(faReadOnly + faHidden) in Delphi or
(faReadOnly | faHidden) in C++ as the Attr parameter.

Note:	FindFirst allocates resources (memory) which must be
released by calling FindClose.

function FindNext(var F: TSearchRec): Integer;
-----------------
Description
FindNext returns the next entry that matches the name and attributes
specified in a previous call to FindFirst. The search record must be one
that was passed to FindFirst. The return value is zero if the function
was successful. Otherwise the return value is an error code.

procedure FindClose(var F: TSearchRec);
-------------------
Description
FindClose terminates a FindFirst/FindNext sequence.
=========================================================
Look out!
  The TP7 FindFirst / FindNext
  a) do not need FindClose
  b) they set DosError to non zero if they fail
  Changes to support FindClose:
  ChkFindClose added for each FindFirst (Project FemurPcDelphi) only
  since 23.03.05 P.W: FindFirst changed to FindFirstDE and FindNext to
  FindNextDE all callers checked and also renamed
  SysUtils.FindFirst FindNext have also been checked
  Now FindFirst and FindNext of Dos are no longer public!
*)

procedure ChkFindClose(var F: SearchRec);
begin
  SysUtils.FindClose(F);
end;

// FindFirstDE is used to replace FindFirst of Turbo 7.0 to avoid
// conflict with SysUtils FindFirst FindNext; "DE" means DosError
procedure FindFirstDE(Path: String; Attr: Word; var F: SearchRec);
// Convert Turbo to Delphi
// Modifications:
// 20.02.04 P.W to Delphi
// PathStr to String 03.10.07 P.W
//
// Look out! Delphi FindFirst supports FindClose if whitout success!
var
  res : LongInt;
begin
  res := SysUtils.FindFirst(FExpand(Path), Attr, F); // FExpand added (04.03.04 P.W)
  If (Res = 0) then
  begin
    DosError := DosErr_NoError;
  end else
  begin
    DosError := DosErr_NoMoreFiles;
    ChkFindClose(F);
  end;
end;

// FindNextDE is planed to replace FindNext of Turbo 7.0 to avoid
// conflict with SysUtils FindFirst FindNext; "DE" means DosError
procedure FindNextDE(var F: SearchRec);
// Convert Turbo to Delphi
// Modifications:
// 20.02.04 P.W
var
  res : LongInt;
begin
  Res := SysUtils.FindNext(F);
  If (Res = 0) then
  begin
    DosError := DosErr_NoError;
  end else
  begin
    DosError := DosErr_NoMoreFiles;
    ChkFindClose(F);
  end;
end;

procedure DelphiUnpackTime(const P: Longint;
            var Year, Month, Day, Hour, Minute, Sec: Word);
// Modifications:
// 20.02.04 P.W
// Convert Turbo to Delphi
var
  TimDelphi: TDateTime;
begin
  TimDelphi := FileDateToDateTime(P);
  Year  := YearOf(TimDelphi);
  Month := MonthOf(TimDelphi);
  Day   := DayOf(TimDelphi);
  Hour  := HourOf(TimDelphi);
  Minute:= MinuteOf(TimDelphi);
  Sec   := SecondOf(TimDelphi);
end;

procedure UnpackTime(const P: Longint; var T: DateTime);
// Convert Turbo to Delphi
// Modifications:
// 20.02.04 P.W
begin
  With T do
    DelphiUnpackTime(P, Year, Month, Day, Hour, Min, Sec);
end;

