procedure FSplit(Path: String; var Dir: DirStr; var Name: NameStr; var Ext: ExtStr);
// Convert Turbo to Delphi
// Modifications:
// 20.02.04 P.W
// 23.04.04 P.W
//   only check add "\" if Dir is not empty!
// PathStr to String 03.10.07 P.W
begin
  Dir  := ExtractFileDir(Path);
  If (Length(Dir) > 0) then  // 23.04.04 P.W
    If (Dir[Length(Dir)] <> '\') then Dir := Dir + '\';  // (08.03.04. P.W)
  Name := ChangeFileExt(ExtractFileName(Path), '');
  Ext  := ExtractFileExt(Path);
end;

procedure FSplitA(const Path: PathStrA; var Dir: DirStrA;
  var Name: NameStrA; var Ext: ExtStrA);
// Created: 07.04.05 P.W
// Purpose: Replace FSplit support Long FileNames
// Modifications:
begin
  Dir  := ExtractFileDir(Path);
  If (Length(Dir) > 0) then
    Dir := IncludeTrailingPathDelimiter(Dir);
  Name := ChangeFileExt(ExtractFileName(Path), '');
  Ext  := ExtractFileExt(Path);
end;

