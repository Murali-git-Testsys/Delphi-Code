(*.**************************************************************************)
Function    TMacro.OpenRead
 (
  State:TMacroState     { I  - may be MRead or MExtRead }
 ):Smallint;
(***************************************************************************
Date/Author      : {11.08.95 Michael Welsch}
Description      : opens a macro stream. Automatic switch of the extension
for MRead (.CHA) and MExtRead (.CHE). In MExtRead mode, the macroversion
is checked.
***************************************************************************
return           : status of the stream
heap             : x
Global Variables
 - affected      :
 - predefined    :
---------------------------------------------------------------------------
virtual          :
change  status   : x
***************************************************************************
Date/Modification:
{26.11.96 Michael Welsch,Macroheader implemented
{24.10.02 P.W} no longer beep
**************************************************************************.*)

Var
(*  _MACROVERSION :       String10;*)
  NH               : TMacroHeader;
  Res              : Smallint;      {23.10.01 P.W}
begin
  Error:=0;
  If MacroStream<>NIL Then
  begin
    Dispose(MacroStream,Done);
    MacroStream:=NIL;
  end;
  GlbSaveMacroExtFileName:=MacroFileName;
  _PrepFileName(State);
{  Beep(100,0.5);}          {until: 24.10.02 P.W}
  Macrostate:=State;
  If FileExist(MacroFileName) Then
  begin
    MacroStream:=New(PBufStream,Init(MacroFileName,stOpenRead,MACROBUFSIZE));
    If (State in [MExtRead,MExtAutoRead]) Then
    begin
      Res:=Read(NH,SizeOf(NH));
      If (Res=0) then                         {23.10.01 P.W}
      begin
        If Not Assigned(MacroHeader) then
          MacroHeader := New(PMacroHeader);
        MacroHeader^ := NH;
      end;
{      If (NH._MACROVERSION<>MACROVERSION) Then}         {u.: 23.10.01 P.W}
      If (NH._MACROVERSION < MinMacroVersSupported)      {s.: 23.10.01 P.W}
         or
         (NH._MACROVERSION > MacroVersion)
      Then 
      begin
        CloseStream;
        ErrorMacro;
        Error:=Error_WrongMacroVersion;
      end else
        Error:=MacroStream^.Status;

(*
      Read(_MACROVERSION,SizeOf(_MACROVERSION));
      If _MACROVERSION<>MACROVERSION Then
      begin
        CloseStream;
        ErrorMacro;
        Error:=Error_WrongMacroVersion;
      end else
        Error:=MacroStream^.Status;
*)
    end else
      Error:=MacroStream^.Status;
  end else
  begin
    Macrostate:=MNotActive;
    Error:=Error_MacroNotFound;
(*    OpenRead:=Error_MacroNotFound;*)
  end;
  If MACROCALLBACK<>NIL Then
     MACROCALLBACK^;
  OpenRead:=Error;
  MacroRuns := (Error =0); // 04.04.08 P.W
end;
{----------------------------------------------------------------------------}
Function    TMacro.CloseStream:Smallint;
begin
  Result := 0; // Result defined 25.08.04 P.W

  Error:=0;
  If MacroStream<>NIL Then
  begin
    If (MacroState<>MExtAutoWrite) Then
       Beep(100,0.5);
    Dispose(MacroStream,Done);
    MacroStream:=NIL;
    Macrostate:=MNotActive;
    SaveMyState:=MNotActive; {07.04.97 MW}
    MacroFileName:=GlbSaveMacroExtFileName;
    EmptyKeyBuf;
    If MACROCALLBACK<>NIL Then
       MACROCALLBACK^;
  end;
  If MacroContStream<>NIL Then
  begin
    Dispose(MacroContStream,Done);
    MacroContStream:=NIL;
  end;
end;
