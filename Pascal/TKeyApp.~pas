{ used for persistance...}
Constructor TMacro.Load(var S:TStream_TP7); // "TStream" to "TStream_TP7" Chg#1643 (02.03.04 P.W)
Var
  MacroPos     :       LongInt;
begin
  S.Read(MacroState,SizeOf(MacroState));
  S.Read(SaveMyState,SizeOf(SaveMyState));
  S.Read(MacroWait,SizeOf(MacroWait));
  S.Read(MacroPos,SizeOf(MacroPos));
  S.Read(MacroFileName,SizeOf(MacroFileName));
  S.Read(Error,SizeOf(Error));
  S.Read(EndAfterMacro,SizeOf(EndAfterMacro));
  MacroStream:=NIL;
  MacroContStream:=NIL;
  MacroHeader:=NIL;  {23.10.01 P.W}
  If MacroState<>MNotActive Then
  begin
    Case MacroState  Of
      MRead,MExtRead,MExtAutoRead    : OpenRead(MacroState);
      MWrite,MExtWrite,MExtAutoWrite : OpenWrite(MacroState,TRUE);
    end;
    If Error=0 Then
    begin
      MacroStream^.Seek(MacroPos);
      Error:=MacroStream^.Status;
    end;
  end;
  If MacroState=MExtWrite Then         {19.11.96 Michael Welsch}
  begin
    S.Read(MacroPos,SizeOf(MacroPos));
    If MacroContStream<>NIL Then
       MacroContStream^.Seek(MacroPos);
  end;

end;
{----------------------------------------------------------------------------}
Procedure   TMacro.Store(var S:TStream_TP7); // "TStream" to "TStream_TP7" Chg#1644 (02.03.04 P.W)
Var
  MacroPos     :       LongInt;
begin
  S.Write(MacroState,SizeOf(MacroState));
  S.Write(SaveMyState,SizeOf(SaveMyState));
  S.Write(MacroWait,SizeOf(MacroWait));
  If MacroState<>MNOTActive Then
     MacroPos:=MacroStream^.GetPos
  else
     MacroPos:=0;
  S.Write(MacroPos,SizeOf(MacroPos));
  S.Write(MacroFileName,SizeOf(MacroFileName));
  S.Write(Error,SizeOf(Error));
  S.Write(EndAfterMacro,SizeOf(EndAfterMacro));
  If MacroState=MExtWrite Then
  begin
    MacroPos:=MacroContStream^.GetPos;
    S.Write(MacroPos,SizeOf(MacroPos));
  end;
