(*.**************************************************************************)
Procedure  TMacro.GetNextItem
 (
  Var HCH       :Char;     {  O - character input from keyboard or macro }
  RWCharFlg     :Boolean   { I  - TRUE=keyboard is simulated in extended macro }
 );
(***************************************************************************
Date/Author      : {11.08.95 Michael Welsch}
Description      : Input from keyboard or macro character.
RWCharFlg is a field of the keybourd object (TApp). It determines if
the keyboard is simulated in the extended macro mode too.(default=false).
If a child of TApp doesn't save specific data in the extended macro stream,
it should set it's RWCharFlg=TRUE to save at least keystrokes.
***************************************************************************
return           :
heap             :
Global Variables
 - affected      :
 - predefined    :
---------------------------------------------------------------------------
virtual          :
change  status   :
***************************************************************************
Date/Modification:
**************************************************************************.*)

begin
  Case Macrostate Of
   MRead     : Read(HCh,SizeOf(HCH));
   MExtRead,
   MExtAutoRead  : begin
                 If RWCharFlg Then
                    Read(HCh,SizeOf(HCH))
                 else
                    HCh:=ReadKey;

               end;
   MWrite    : begin
                 HCh:=ReadKey;
                 Write(HCh,SizeOf(HCH));
               end;
   MExtWrite,
   MExtAutoWrite
             : begin
                 HCh:=ReadKey;
                 If RWCharFlg Then
                   Write(HCh,SizeOf(HCH));
               end;
   else
                HCh:=ReadKey;
  end;

end;
