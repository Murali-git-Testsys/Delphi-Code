Function    TMacro.OpenWrite
 (
  State         :TMacroState; { I  - may be MWrite or MExtWrite }
  UseExisting   :Boolean      { I  - False=overwrite or True=may be appended }
 ):Smallint;
(***************************************************************************
Date/Author      :{11.08.95 Michael Welsch}
Description      :Open an macro file for writing. If UseExisting=True the
filemode is only stOpenwrite (file must exist), seek to the end of file to
append data.
Fileextensions are automatically changed between modes:
Keystroke = *.cha,
extended  = *.che,
***************************************************************************
return           : status of stream
heap             : x
Global Variables
 - affected      :
 - predefined    :
---------------------------------------------------------------------------
virtual          :
change  status   : x
***************************************************************************
Date/Modification:
{26.11.96 Michael Welsch} Macro header implemented
{05.10.01 P.W}
  Macro Header (Ascii contentfile) Creation date and time added
**************************************************************************.*)

Var
  Res   :       Smallint;
  Str   :       String;
  NH    :       TMacroHeader;
  TempTime         : String05; {05.10.01 P.W}
begin
  Error:=0;
  If MacroStream<>NIL Then
  begin
    Dispose(MacroStream,Done);
    MacroStream:=NIL;
  end;
  If MacroContStream<>NIL Then
  begin
    Dispose(MacroContStream,Done);
    MacroContStream:=NIL;
  end;
  GlbSaveMacroExtFileName:=MacroFileName;
  _PrepFileName(State);
  Macrostate:=State;
  If (MacroState<>MExtAutoWrite) Then
     Beep(100,0.5);
  Str:=DoFSplit(MacroFileName,C_DirNam)
       +'.TXT';
  If UseExisting Then
  begin
(*     MacroStream:=New(PBufStream,Init(MacroFileName,stOpenWrite,MACROBUFSIZE));*)
     {26.11.96 Michael Welsch open file for read and write!!}
     MacroStream:=New(PBufStream,Init(MacroFileName,stOpen,MACROBUFSIZE));
     If State=MExtWrite Then
        MacroContStream:=New(PBufStream,Init(Str,stOpenWrite,MACROBUFSIZE))
  end else
  begin
     MacroStream:=New(PBufStream,Init(MacroFileName,stCreate,MACROBUFSIZE));
     If (State in [MExtWrite,MExtAutoWrite]) Then
     begin
       GetDefMacroHeader(NH);
       Write(NH,SizeOf(NH));
(*        Write(MACROVERSION,SizeOf(MACROVERSION));*)
     end;

     If State=MExtWrite Then
     begin
       MacroContStream:=New(PBufStream,Init(Str,stCreate,MACROBUFSIZE));
       WriteContent(MACROVERSION);
       WriteContent(FT('Single slice macro',FL,CONTHEADLEN));
         {^- will be overwritten later if a multi slice macro! }
         {   by Procedure TMacro.SetMacroSliceType             }
       {v--- add creation date and time 05.10.01 P.W}
         GetSysTimeHHPMM(TempTime);
         WriteContent(
           FT('Created at',FM,20)
           + ' ('
           + ConvDate(FT('DD.MM.YYYY',FL,10))
           + ') '
           + ConvDate(MyGetDate)
           + ' '
           + TempTIME
           );
         WriteContent('UserId = ' + GlbUserId);
       {^--- add creation date and time 05.10.01 P.W}
     end;
  end;
  Res:=MacroStream^.Status;
  If Res<>0 Then
    CloseStream;
  Error:=Res;
  If MACROCALLBACK<>NIL Then
     MACROCALLBACK^;
  OpenWrite:=Res;
end;
