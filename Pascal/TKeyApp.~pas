Procedure   TMacro.WriteMacroHeader(Var NH:TMacroHeader);
Var
   SP   :       LongInt;
begin
  If (MacroState<>MEXTWrite) Or (MacroStream=NIL) Then
     Exit;
  SP:=MacroStream^.GetPos;
  MacroStream^.Seek(0);
  MacroStream^.Write(NH,SizeOf(NH));

  If Not Assigned(MacroHeader) then     {23.10.01 P.W}
    MacroHeader := New(PMacroHeader);
  MacroHeader^ := NH;                   {23.10.01 P.W}

  MacroStream^.Seek(SP);
end;
{----------------------------------------------------------------------------}
Function   TMacro.ReadMacroHeader(Var NH:TMacroHeader):Smallint;
Var
   SP           :       LongInt;
   Res          :       Smallint;
   CloseFlg     :       Boolean;
begin
  Res := 0; // Res defined 25.08.04 P.W

  FillChar(NH, SizeOf(NH), #0);
  CloseFlg:=(MacroStream=NIL);
  If CloseFlg Then { this expects that macrofilename contains the wanted macro!! }
  begin
    _PrepFileName(MEXtRead);
    MacroStream:=New(PBufStream,Init(MacroFileName,stOpenRead,1024));
  end;
  If MacroStream<>NIL Then
  begin
    SP:=MacroStream^.GetPos;
    MacroStream^.Seek(0);
    Res:=Read(NH,SizeOf(NH)); { attention!! this may dispose the macrostream!!!}

    If (Res=0) then                         {23.10.01 P.W}
    begin
      If Not Assigned(MacroHeader) then
        MacroHeader := New(PMacroHeader);
      MacroHeader^ := NH;
    end;

    If (SP>=0)
       And
       (MacroStream<>NIL)
       And
       (SP<=MacroStream^.GetSize)
       Then
       MacroStream^.Seek(SP)
    else
       Res:=-1;
    If CloseFlg And (MacroStream<>NIL) Then
    begin
      Dispose(MacroStream,Done);
      MacroStream:=NIL;
      Macrostate:=MNotActive;
    end;
  end;
  ReadMacroHeader:=Res;
end;
{----------------------------------------------------------------------------}
Procedure   TMacro.SetMacroSliceType(SingleSliceType:Boolean);
Var
  NH : TMacroHeader;
  SP : LongInt;
begin
  If ReadMacroHeader(NH)=0 Then
  begin
    NH.SingleSliceFlg:=SingleSliceType;
    WriteMacroHeader(NH)
  end;
  If MacroContStream<>NIL Then
  begin
    SP:=MacroContStream^.GetPos;
    MacroContStream^.Seek(Length(MACROVERSION)+2);  { seek all characters + CR+LF}
    WriteContent(FT(
                 FT('Multi slice macro, starting with: ',FM,40)
                 +GetIntStr(NH.StartSliceNum,3),FL,CONTHEADLEN));
    MacroContStream^.Seek(SP);
  end;
end;
