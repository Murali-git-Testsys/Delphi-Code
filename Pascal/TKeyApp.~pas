(*.*************************************************************************
KeyMouseHandler: get keystrokes and mousemoves
Input   : glb. variable MS ( 1=mouse, 0=no mouse ),
          Mx,My real worldkoordinates, step for moving cursor, cursor or
          mousemoves only in steps bigger than "step/2" are recognized
          -> EXTCode = MOVE, else Extcode=nomove
OutPut  : returns ExtCode ( see KN_GLB ),
          inputcharacter (CH) and new cursor coordinates (MX,MY)
Version : @(#) KN_KEY V:1.0
Author  : M.Welsch
Date    : 15.02.92
Modified: 24.08.92
Modification log:
{22.03.96 Michael Welsch} Accelarator implemented.
{17.04.97 MW}SkipKeyRangeCheck
// Values MX, MY must be defined by callor to avoid exceptions! KeyMouseHandler; 25.08.04 PW

****************************************************************************)
FUNCTION TApp.KeyMouseHandler(                         VAR MX,MY:REAL;
                               XLow,YLow,XHigh,YHigh:Real;
                               XSTEP:REAL;YSTEP:REAL):TExtCode;

VAR
  MouseX, MouseY: Integer;  // 30.04.04 P.W
BEGIN
  Deb0('TApp.KeyMouseHandler 0');
  REPEAT
    ExtCode:=nomove; {22.03.96 Michael Welsch}

    if (GetOkButtonDown(False) > 0) then      // 05.05.04 P.W
    begin
      ExtCode := _Move;
      InpCh   := #0;
    end else
    If (GetListBoxClickLine(False) > 0) then  // 30.04.04 P.W
    begin
      ExtCode := _Move;
      InpCh   := #0;
    end else
    If IsPaneClicked(MouseX, MouseY) then     // 30.04.04 P.W
    begin
      if addr(MX) = addr(MY) then
      begin  // used by UtParam Threshold Dialog: Up or Right the same
        MX  := GetPaneKeyXValue(MouseX);
      end else
      begin
        MX  := GetPaneKeyXValue(MouseX);
        MY  := GetPaneKeyYValue(MouseY);
      end;
      ExtCode := _MOVE;
      InpCh   := #0;
    end;

    If Acc<>NIL Then
       Acc^.PreWaitKey;
(*    IF KEYPRESSED Or (Macro.Macrostate=MREAD) THEN*)
    IF KEYPRESSED Or (Macro.Macrostate=MREAD)
       Or ((Macro.Macrostate=MEXTREAD) And RWCharFlg) THEN {04.11.96 Michael Welsch}
    BEGIN
      FlowEvent:=TRUE;
      SkipKeyRangeCheck:=FALSE;
      KeyToExtCode;

      UKeyHandler;
      If (Acc<>NIL) And (Macro.MacroState=MNotActive) Then
      begin
        Acc^.PostWaitKey(Word(ExtCode), Byte(ExtCode));
        Case ExtCode Of
          LEFT,RIGHT : Acc^.IncAccProcR(MX,ExtCode=RIGHT,XStep,XLow,XHigh);
          UP,DWN     : Acc^.IncAccProcR(MY,ExtCode=UP   ,YStep,YLow,YHigh);
        end;
      end else
      begin
        Case ExtCode Of
          LEFT : MX := MX-XSTEP;
          RIGHT: MX := MX+XSTEP;
          UP   : MY := MY+YSTEP;
          DWN  : MY := MY-YSTEP;
        end;
      end;
      Case ExtCode Of
        SF1  : Macro.OpenWrite(MWrite,FALSE);  { keystroke recorder }
        SF2  : Macro.CloseStream;
        SF3  : Macro.OpenRead(MRead);
	SF10 : begin
(*                 If Service Then
		 begin
                   TestWindow;
                 end;
*)
               end;
      end;
      If Not SkipKeyRangeCheck Then
      begin
        If MX<XLow Then MX:=XHigh;
        If MX>XHigh Then MX:=XLow;
        If MY<YLow Then MY:=YHigh;
        If MY>YHigh Then MY:=YLow;
      end;
(*
      If Service Then
      begin
         Writeln('Cursorposition: CX= ',MX:3:0,' CY= ',MY:3:0,' in Worldkoordinaten');
      end;
*)
    end else
    begin
      Delay(1);  // 02.11.05 P.W   frees system resources
      GlbIdleProc;
      IdleTask;
    end;


