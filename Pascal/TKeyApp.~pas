    else GetMacroVersion := MACROVERSION;
end;
{----------------------------------------------------------------------------}
Procedure   TMacro.GetDefMacroHeader(Var NH : TMacroHeader);
begin
  FillChar(NH, SizeOf(NH), #0);
  With NH Do
  begin
    _MACROVERSION      :=MACROVERSION;
    HeadLen            :=SizeOf(NH);
    SingleSliceFlg     :=TRUE;
    StartSliceNum      :=1;
  end;

  If Not Assigned(MacroHeader) then     {23.10.01 P.W}
    MacroHeader := New(PMacroHeader);
  MacroHeader^ := NH;                   {23.10.01 P.W}
end;
