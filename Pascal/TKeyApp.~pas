Function  TApp.CheckPicture(PictureCH:Char):Boolean;
(*
  Modifications:
{23.10.01 P.W}
  added PictureCh = '+' for positive floating points numbers
*)
Var
  Flg   :       Boolean;
begin
{GlbDebugMsg('TKeyApp.Pas TApp.CheckPicture "'+PictureCH+'"');}
  Flg:=True;
  If PictureCH='x' Then
  begin
    CheckPicture:=TRUE;
    Exit;
  end;
  Case PictureCh Of
   '!' : begin  { to upcase }
           InpCh:=UpCase(InpCh);
           Flg:=True;
         end;
   'A' : begin  { alpha upcase }
           InpCh:=UpCase(InpCh);
           Flg:=((ORD(InpCh)>=65) And (ORD(InpCh)<=90));  {"A" .. "Z"}
         end;
   'a' : begin  { alpha }
           Flg:=((ORD(InpCh)>=65) And (ORD(InpCh)<=90))   {"A" .. "Z"}
                Or
                ((ORD(InpCh)>=97) And (ORD(InpCh)<=122)); {"a" .. "z"}
         end;
   '9' : begin  { numeric and space }
           Flg:=((ORD(InpCh)>=48) And (ORD(InpCh)<=57))   {"0" .. "9"}
                Or
                (ORD(InpCh)=32);                          {" "}
         end;
   '+' : begin  {23.10.01 P.W}
                { numeric and space and dec. point BUT not "-"}
           Flg:=((ORD(InpCh)>=48) And (ORD(InpCh)<=57))   {"0" .. "9"}
                Or
                (ORD(InpCh)=32)                           {" "}
                Or
                (ORD(InpCh)=43)                           {"+"}
                Or
                (ORD(InpCh)=46);                          {"."}
         end;
   '#' : begin  { numeric and space and sign and dec. point}
           Flg:=((ORD(InpCh)>=48) And (ORD(InpCh)<=57))   {"0" .. "9"}
                Or
                (ORD(InpCh)=32)                           {" "}
                Or
                (ORD(InpCh)=43)                           {"+"}
                Or
                (ORD(InpCh)=45)                           {"-"}
                Or
                (ORD(InpCh)=46);                          {"."}
         end;
    'n': Flg:=False;
   end;
   CheckPicture:=Flg;
end;
