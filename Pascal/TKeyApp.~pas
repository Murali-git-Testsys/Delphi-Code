(*.**************************************************************************)
Function    TMacro.CheckRead:Smallint;
(***************************************************************************
Date/Author      :{11.08.95 Michael Welsch}
Description      : check before and after read operation. If the end of
the stream is reached, (Status=stReadError = -3) the macrostate is reseted
to MNotActive.
ATTENTION: This Proc. is called automatically by Read(..). If direct reading
(by MacroStream^.Read(..)) is used, capsulate the reading like this:
If Macro.CheckRead=0 Then
begin
  MacroStream^.Read(..)
  Macro.CheckRead;
end
***************************************************************************
return           : 0 = OK, -3=EOF or not avail.
heap             : x, call closestream
Global Variables
 - affected      : x, TApperrorlog file may be changed
 - predefined    :
---------------------------------------------------------------------------
virtual          :
change  status   : x
***************************************************************************
Date/Modification:
**************************************************************************.*)
Var
  txt            :    Text;
  Res   :       Smallint;
begin
  If MacroStream=NIL Then
  begin
    CheckRead:=stReadError;
    Exit;
  end;
  Res:=MacroStream^.Status;
  If (Res=0) And
     (MacroStream^.GetPos=MacroStream^.GetSize) Then
     Res:=stReadError;            { reach EOF }
  If (Res<>0) Then
  begin
    If (Res<>stReadError) Then
    begin
      Assign(txt,FExpand(TAppErrorlog)); // FExpand added (04.03.04 P.W)
      If FileExist(TAppErrorlog) Then Append(txt)
      else Rewrite(txt);
      Writeln(txt,FT_( '=',MU,30));
      Writeln(txt,'Macroerror: IoResult=',Res);
      Writeln(txt,FT_( '=',MU,30));
      Close(txt);
    end;
    CloseStream;
    ErrorMacro;
  end;
  CheckRead:=Res;
end;
{----------------------------------------------------------------------------}
Function    TMacro.Read(Var V;Size:Word):Smallint;
{ return : 0 = success, caller can use V,
         <>0 = fail,V is not changed
}
Var
  Res            :    Smallint;
begin
  If MacroWait<>0 Then Delay(MacroWait);

  Res:=CheckRead;
  If Res=0 Then
  begin
    MacroStream^.Read(V,Size);
    Res:=MacroStream^.Status;
(*    CheckRead; *) {13.10.95 Michael Welsch}
  end;
  Read:=Res;
end;
{----------------------------------------------------------------------------}
Function    TMacro.Write(Var V;Size:Word):Smallint;
begin
  MacroStream^.Write(V,Size);
  Write:=MacroStream^.Status;
end;
