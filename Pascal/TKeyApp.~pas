    HCh            :    Char;

  begin
  (*
    With Macro Do
    begin
      Case Macrostate Of
       MRead     : Read(HCh,SizeOf(HCH));
       MWrite    : begin
                     HCh:=MyReadKey;
                     Write(HCh,SizeOf(HCH));
                   end;
       else        HCh:=MyReadKey;
      end;
    end;
  *)
    Macro.GetNextItem(HCH,RWCharFlg);
    GetNextChar:=HCh;
  end;

Var
  Ch2   :       Char;

begin
   InpCh:=GetNextChar;
   If InpCh=#0 Then
   begin
