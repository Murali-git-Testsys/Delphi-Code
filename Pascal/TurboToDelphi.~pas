const
  AppBlockChkPrevMax = 1;
type
  TAppBlockChk = record   //29.11.07 P.W
    // used to detect when application is paused because of moving a window
    StartFlg   : Boolean;
    StartTime,
    CurSec     : TDateTime;
    CurCtr     : Integer;  // times ApplicationprocessMessages has been called in CurrentSec
    PrevCount  : Integer;
    PrevSec    : Array[0 .. AppBlockChkPrevMax] of TDateTime;
    PrevCtr    : Array[0 .. AppBlockChkPrevMax] of Integer;
  end;

procedure AppBlockChkUpd(var ABC: TAppBlockChk; CurTime: TDateTime);
//29.11.07 P.W
const
  SecStep = 1.0;
var
  I : Integer;
begin
  if not ABC.StartFlg then
  begin
    ABC.StartFlg     := True;
    ABC.StartTime    := CurTime;
    ABC.CurSec       := CurTime;
    ABC.CurCtr       := 0;
    ABC.PrevCount    := 0;
  end;

  if (SecondSpan(ABC.CurSec, CurTime) < SecStep) then
  begin // in current second
    Inc(ABC.CurCtr);
  end else
  begin // new second
    // shift to higher index
    ABC.PrevCount := Min(ABC.PrevCount +1, AppBlockChkPrevMax);
    for I := 1 to AppBlockChkPrevMax do
    begin
      ABC.PrevSec[I] := ABC.PrevSec[I-1];
      ABC.PrevCtr[I] := ABC.PrevCtr[I-1];
    end;
    // insert Cur at [0]
    ABC.PrevSec[0]:= ABC.CurSec;
    ABC.PrevCtr[0]:= ABC.CurCtr;

    // init current
    ABC.CurSec := CurTime;
    ABC.CurCtr := 0;
  end;
end;

function AppBlockChk_Blocked(var ABC: TAppBlockChk): Boolean;
//29.11.07 P.W
label
  L_Ok, L_Blocked;
begin
  if (not ABC.StartFlg)                                then goto L_Ok;

  if (SecondSpan(ABC.CurSec, SysUtils.GetTime) > 2.0)  then goto L_Blocked;

  if (ABC.PrevCount  = 0)                              then goto L_Ok;

  if (SecondSpan(ABC.CurSec, ABC.PrevSec[0]  ) > 2.0)  then goto L_Blocked;
  if (ABC.PrevCtr[0] < 5)                              then goto L_Blocked;

  if (ABC.PrevCount  = 1)                              then goto L_Ok;

  if (ABC.PrevCtr[1] < 5)                              then goto L_Blocked;
  if (SecondSpan(ABC.CurSec, ABC.PrevSec[1]  ) > 4.0)  then goto L_Blocked;

 L_Ok:
  Result := False;  // not blocked
  EXIT;

 L_Blocked:
  Result := True;   // blocked detected
end;

var
  AppTimer       : TDateTime = 0;
  AppBlockChkGlb : TAppBlockChk;    // 29.11.07 P.W

function AppBlockChkGlb_Blocked: Boolean;
//29.11.07 P.W
// used by FemCmd2.pas CheckDeviceResponding
begin
  Result := AppBlockChk_Blocked(AppBlockChkGlb)
end;

procedure ApplicationProcessMessages;
// purpose:
//   a) avoid too many calls of Application.ProcessMessages
//   b) support RequestSound
//   c) support AppBlockChkUpd to allow DeviceResponding check to detect blocked appplication
// modifications:
// 22.06.07 P.W: enable support of Requested sound again.
// 29.11.07 P.W: support AppBlockCheck
// 27.06.08 P.W: support DisableRequestSound
var
  CurTime : TDateTime;
begin
  if (DeltaAppProcMsgSec < 0.001) then EXIT;
  CurTime := SysUtils.GetTime;
  AppBlockChkUpd(AppBlockChkGlb, CurTime);  // 29.11.07 P.W
  If (AppTimer = 0) or (Abs(AppTimer - CurTime)* 3600.0 * 24.0 > DeltaAppProcMsgSec)
or DebugMode
  then
  begin
    AppTimer := CurTime;
    if (RequestSound <> RS_None) then
    begin
      if DisableRequestSound then   // 27.06.08 P.W
        RequestSound := RS_None;

//    if (mpCanPlay in frmMain.mdplyMeasurement.Capabilities) then     // is false before the first open!// here u. 22.06.07 P.W
      Case RequestSound of
        RS_Error{1}: begin   // ErrBox
             MediaPlay(LocMediaDir+'Sound_Error.wav'); //C:\WINDOWS\Media\chord.wav
           end;
        RS_Start{2}: begin  // Sound_Start
             MediaPlay(LocMediaDir+'Sound_Start.wav'); //C:\WINDOWS\Media\chimes.wav
           end;
        RS_End{3}: begin  // Sound_End
             MediaPlay(LocMediaDir+'Sound_End.wav');   //C:\WINDOWS\Media\ding.wav
           end;
        RS_Wait{4}: begin  // Sound_Wait
             MediaPlay(LocMediaDir+'Sound_Wait.wav');  //C:\WINDOWS\Media\chimes.wav
           end;
        // v---  27.06.08 P.W:
        RS_Beep:               MessageBeep($FFFFFFFF);  // -> MessageBeep(-1);
        RS_MB_OK:              MessageBeep(MB_OK);
        RS_MB_ICONHAND:        MessageBeep(MB_ICONHAND);
        RS_MB_ICONQUESTION:    MessageBeep(MB_ICONQUESTION);
        RS_MB_ICONEXCLAMATION: MessageBeep(MB_ICONEXCLAMATION);
        RS_MB_ICONASTERISK:    MessageBeep(MB_ICONASTERISK);

      end;
      RequestSound := RS_None;
    end;
    Application.ProcessMessages;
  end;
  AppProcMsgTimeSumGlb := AppProcMsgTimeSumGlb + SecondSpan(SysUtils.GetTime, CurTime); // 02.11.09 P.W
end;

Procedure ChkEnableMainForm; // 07.01.08 P.W
var
  MF : TForm;
begin
  if Assigned(Application.MainForm) then
  begin
    MF := Application.MainForm;
    if not MF.Visible then MF.Visible := True;
    if not MF.Enabled then MF.Enabled := True;
  end;
end;

Procedure DelphiSleep(msDelay: Integer);
var
  DelayPart : Integer;
begin
  Repeat
    DelayPart := Min(msDelay, 100);  
    ApplicationProcessMessages;      // call also for msDelay = 0 !
    Sleep(DelayPart);
    Dec(msDelay, DelayPart);
  until (msDelay <= 0);
end;

