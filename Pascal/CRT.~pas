procedure GotoXY;           {external;  external u.: 22.10.03 P.W}
begin // code inserted 19.07.04 P.W
  if CrtCurWanted then
  begin
    if ((CurX <> X) or (CurY <> Y)) then
    begin
      if CurVisible
        then CurInvert
        else StartDosTimer(CurTimer);
    end;
  end;
  CurX := X;
  CurY := Y;
  CrtCurWanted := True;
end; {empty code: 22.10.03 P.W}

