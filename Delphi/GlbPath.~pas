function GetXctDevFromSelSetBat: String; // 02.05.05 P.W
const
  SelSetName = 'SelSet.bat';
var
  SL : TStringList;
  P : Integer;
begin
  Result := '';
  if FileExists(SelSetName) then
  begin
    SL := TStringList.Create;
    SL.LoadFromFile(SelSetName);
    if SL.Count > 0 then
    begin
      P := Pos('=', SL[0]);
      If P > 0 then
      Result := Copy(SL[0], P+1, 255);
    end;
    FreeAndNil(SL);
  end;
end;

