Function DateGerToInt(DGer:String10;CountryCode:Word):String10;
(*
Modifications:
{17.06.02 P.W}
  completely new to avoid problems when year is not at end
  Expected Input: DGer : "Dd.Mm.Yyyy" (Dd:day ; Mm: Month; Yyyy: Year)
  Output: order defined by DateDescriptor(CountryCode)
    Length of Year is 4 digits when IncCentury is true
    Format of DateDescriptor: "ABCS" ABC may each be one out of "DMY"
                                     S   is the wanted separator like "."

*)
Var
  Desc  : String04;
  DInt  : String10;

  Function GerPart(DescPos: Smallint): String04;
  begin
    Case Desc[DescPos] of
      'D':   GerPart := Copy(DGer, 1, 2); {"Dd"   = Day}
      'M':   GerPart := Copy(DGer, 4, 2); {"Mm"   = Month}
      'Y': If IncCentury
           Then
             GerPart := Copy(DGer, 7, 4)  {"Yyyy" = Year4}
           Else
             GerPart := Copy(DGer, 9, 2); {  "yy" = Year2}

      Else   GerPart := '';               {""     = invalid}
    end;
  end;
begin
  Desc :=DateDescriptor(CountryCode);
  {DInt :=FT_( ' ',MU,10);}

  DInt := GerPart(1) +
          Desc[4]    +  {Separator}
          GerPart(2) +
          Desc[4]    +  {Separator}
          GerPart(3);

  DInt := FT_(DInt, FL, 10);

  DateGerToInt:=DInt;
end;

