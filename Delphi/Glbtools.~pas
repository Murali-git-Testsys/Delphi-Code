FUNCTION FT (TXT     : STRING ; F : FTTYPE ; FL : BYTE) : STRING ;
Var
   I       :       Byte;
   Stxt    :       String;
BEGIN
  CASE ORD(F) OF
    0 : WHILE LENGTH(TXT) < FL DO TXT := TXT+' ' ;
    1 : WHILE LENGTH(TXT) < FL DO TXT := ' '+TXT ;
    2 :
    WHILE LENGTH(TXT) < FL DO
    BEGIN
      TXT := ' '+TXT ;
      IF LENGTH(TXT) < FL THEN TXT := TXT+' ' ;
    END ;
    3 : BEGIN
         If Length(txt)>FL Then txt:=Copy(txt,1,FL);
        END ;
    4 : begin
         STxt:=txt;
         txt:='';
         For I:=1 To FL Do txt:=txt+Stxt;
        end;
  END ;
  FT := TXT ;
END ;
}
