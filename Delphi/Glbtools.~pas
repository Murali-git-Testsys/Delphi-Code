Function IndexRoll(RefInd,Increment,MinInd,MaxInd:Smallint):Smallint;
{
 02.07.96 Michael Welsch
 Falls Abs(Increment) größer als der maximale Bereich war, war //OemToAnsi Chg#184 (02.03.04 P.W)
 das Ergebnis manchmal nicht in [MinInd,MaxInd]!
 z.B.:
 IndexRoll(1,-4,1,3)->0; !! FEHLER!!
 jetzt:
 IndexRoll(1,-4,1,3)->3;
}
Var
  H             :       Smallint;
begin
  H:=Increment div (MaxInd-MinInd+1);
  If H<>0 Then
    Increment:=Increment-H*(MaxInd-MinInd+1);
  RefInd:=RefInd+Increment;
  If RefInd>MaxInd Then RefInd:=MinInd+RefInd-(MaxInd+1)
  else
  If RefInd<MinInd Then RefInd:=(MaxInd+1)-(MinInd-RefInd);

  { Notbremse falls RefInd bereits außerhalb des Bereiches ist: } //OemToAnsi Chg#183 (02.03.04 P.W)
  If RefInd<MinInd Then RefInd:=MinInd
  else
  If RefInd>MaxInd Then RefInd:=MaxInd;
  IndexRoll:=RefInd;
end;
