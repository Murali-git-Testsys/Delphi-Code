Procedure  GetCollectionFileList(Path,Maske:String;Var List:PStringCollection);
{23.04.96 Michael Welsch
If Duplicates=FALSE, the Pstring is disposed !!
{20.03.97 MW
Archive substituted by Anyfile
(although it seems that Findfirst anyhow gives all files, disregarding
wether the archive bit is set or not!)
}
Var
  F       :       SearchRec;
  SC      :       Smallint;
  PS      :       PString;
begin
  If List=NIL Then
    List:=New(PStringCollection,Init(10,5));
  Path:=DoFSplit(Path,C_Dir);
  FindFirstDE(Path+Maske,AnyFile and NOT Directory,F);
  while DosError = 0 do
  begin
    SC:=List^.Count;
    PS:=Objects.NewStr(Path+F.Name);
    List^.Insert(PS);
    If SC=List^.Count Then
      Objects.DisposeStr(PS);
    FindNextDE(F);
  end;
  ChkFindClose(F); // ChkFindClose (05.03.04 P.W)
end;
