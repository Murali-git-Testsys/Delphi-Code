type
  TMonthDays = Array[0..12] Of Smallint;
function MonthDays: TMonthDays; // 22.03.05 P.W adapt to Delphi
Const
  CMonDays: TMonthDays   = (0,31,28,31,30,31,30,31,31,30,31,30,31);
begin
  Result := CMonDays;
end;

Function DatStrToDays(DatStr:String):LongInt;
var
  MonDays : TMonthDays; // = (0,31,28,31,30,31,30,31,31,30,31,30,31);
Var
  FullYear           : Boolean;
  Help,Day,Year,Month: LongInt;
  i                  : Smallint;
  Result_             : LongInt;
begin
  MonDays := MonthDays;
     DatStrToDays:=0;
     Result_:=0;
     case Length(DatStr) Of
        8:FullYear:=False;
       10:FullYear:=True;
       else Exit;
     end;

     Day:=GetLint(Copy(DatStr,1,2));
     If Not(Day In [1..31]) Then
        Exit;

     Month:=GetLint(Copy(DatStr,4,2));
     If Not(Month In [1..12]) Then
        Exit;

     If FullYear Then
        Year:=GetLint(Copy(DatStr,7,4))
     else
        Year:=GetLint(Copy(DatStr,7,2))+1900;
     If IsLeapyear(Year) Then
        MonDays[2]:=29
     else
        MonDays[2]:=28;

     For i:=0 to (Month-1) Do
        Result_:=Result_+MonDays[i];

     {09.12.96 Michael Welsch}
     Help:=0;
     For I:=0 To Year-1 Do
     begin
       If IsLeapyear(I) Then
         Inc(Help,366)
       else
         Inc(Help,365);
     end;
     Result_:=Result_+Day+Help;
     {...}
     DatStrToDays:=Result_;
end;
