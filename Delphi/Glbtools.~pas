Procedure  GetFileList(Path,Maske:String;Var ListTop:TBasicListPointer);
Var
  F       :       SearchRec;
  Temp    :       TBasicListPointer;
begin
  ListTop:=NIL;
  Path:=DoFSplit(Path,C_Dir);
  FindFirstDE(Path+Maske,Archive,F);
                       {^--Finds file excepted: Hidden, SysFile, VolumeID, Directory}
  If DosError=0 Then
  begin
    New(ListTop);
    ListTop^.NextPtr:=NIL;
    ListTop^.Element:=Path+F.Name;
    Temp:=ListTop;
    while DosError = 0 do
    begin
      FindNextDE(F);
      If DosError = 0 Then
      begin
        New(Temp^.NextPtr);
        Temp:=Temp^.NextPtr;
        Temp^.NextPtr:=NIL;
