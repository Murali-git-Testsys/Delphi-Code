Function AGE(Date1,Date2:String10):Smallint ;
// Date1: Date of birth
// Date2: Date of measurement
// supports Date in this formats
// year with century :
//    dd-mm-yyyy
// year without century:
//    dd-mm-yy
//    in case of yy assume patient is younger than 100 years
// modifications:
// 16.09.05 P.W above description added
Var
   GEB,DAT,Help       :       Smallint;

BEGIN
  {---Jahr---}
  GEB:=GetLInt(Copy(Date1,7,4));
  Dat:=GetLInt(COPY(Date2,7,4));
  IF GEB > DAT THEN DAT := DAT+100 ;
  Help := DAT-GEB ;
  {---Monat---}
  GEB:=GetLInt(COPY(Date1,4,2)) ;
  DAT:=GetLInt(COPY(Date2,4,2)) ;
  IF DAT < GEB THEN
  BEGIN
    Help:= Help-1 ;
    AGE:=Help;
    EXIT ;
  END
  ELSE
  IF DAT = GEB THEN
  BEGIN
    {---Tag---}
    GEB := GetLInt(COPY(Date1,1,2)) ;
    DAT:=GetLInt(COPY(Date2,1,2)) ;
    IF DAT < GEB THEN Help := Help-1 ;
  END ;
  AGE:=Help;
END ;
