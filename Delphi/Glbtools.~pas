   C_Ext   : Result := Ext;      // .EXE                    //
   C_DirNam: Result := Dir+Name; // C:\DICHTE\CALC\KNOCHEN  //
   C_NamExt: Result := Name+Ext; // KNOCHEN.EXE             //
  else
