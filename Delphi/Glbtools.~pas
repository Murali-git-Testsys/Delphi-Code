Function DoFSplit(FName:String; Mode:tSplit):String;
{
Modifications:
04.10.00 P.W:
  Num: Byte Replaced Mode: tSplit
  tSplit   = (C_Dir, C_Nam, C_Ext, C_DirNam, C_NamExt);
  "1" replaced by C_Dir
  "2" replaced by C_Nam
  "3" replaced by C_Ext

  Additional Values for Num supported:
  C_DirNam         Directory + Name (without extension)
  C_NamExt         Name + Extension (without Directory)
}
Var
  Dir   : DirStr;
  Name  : NameStr;
  Ext   : ExtStr;
begin
  FSplit(FName,Dir,Name,Ext);
  Case Mode Of
   C_Dir   : DoFSplit:=Dir;      { C:\DICHTE\CALC\ }
   C_Nam   : DoFSplit:=Name;     { KNOCHEN }
   C_Ext   : DoFSplit:=Ext;      {.EXE }
   C_DirNam: DoFSplit:=Dir+Name; { C:\DICHTE\CALC\KNOCHEN } {04.10.00 P.W}
   C_NamExt: DoFSplit:=Name+Ext; { KNOCHEN.EXE }            {04.10.00 P.W}
  else
   DoFSplit:='';
  end;
end;

Function DoFSplitA(const FName:PathStrA; Mode:tSplit):String;
// Created: 07.04.05 P.W
// Purpose: Replace DoFSplit support Long FileNames
//  C_Dir
//  C_Nam
//  C_Ext
//  C_DirNam         Directory + Name (without extension)
//  C_NamExt         Name + Extension (without Directory)
// Modifications:
Var
  Dir   : DirStrA;
  Name  : NameStrA;
  Ext   : ExtStrA;
begin
  FSplitA(FName,Dir,Name,Ext);
  Case Mode Of
   C_Dir   : Result := Dir;      // C:\DICHTE\CALC\         //
