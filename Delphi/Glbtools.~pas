Function  ChangeDirInString(CurDir,Command:PathStr;Var Erg:String):Smallint;
Var
  SaveDir       :       String;
  Res           :       Smallint;
begin
  Repeat Until (IOResult=0);
  GetDir(0,SaveDir);
  CurDir := FExpand(CurDir); // FExpand added (04.03.04 P.W)
  If Length(CurDir)>3 Then
  begin
    If CurDir[Length(CurDir)]='\' Then
       Delete(CurDir,Length(CurDir),1);
  end;

  Command := FExpand(Command); // FExpand added (04.03.04 P.W)
  If Length(Command)>1 Then
  begin
    If Command[Length(Command)]='\' Then
       Delete(Command,Length(Command),1);
  end;
  ChDir(CurDir);
  Res:=IOResult;
  If Res<>0 Then
  begin
    ChDir(SaveDir);
    ChangeDirInString:=Res;
    Exit;
  end;
  ChDir(Command);
  Res:=IOResult;
  If Res<>0 Then
  begin
    ChDir(CurDir);
    Repeat Until (IOResult=0);
    ChDir(SaveDir);
    Repeat Until (IOResult=0);
    ChangeDirInString:=Res;
    Exit;
  end;
  GetDir(0,Erg);
  ChDir(CurDir);
  Repeat Until (IOResult=0);
  ChDir(SaveDir);
  Repeat Until (IOResult=0);
  ChangeDirInString:=0;
end;
