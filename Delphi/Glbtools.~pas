Function ReadStrRes(Var ResFile:String;ID:Smallint;Line:Word):String;
Var
   TXT          :       Text;
   ResStr       :       String;
   Found        :       Boolean;
   Res          :       Smallint;
   IDStr,IDVal  :       String;
   LineCtr      :       Word;
begin
  LineCtr:=0;
  Found:=False;
  ResFile := FExpand(ResFile); // FExpand added (04.03.04 P.W)
  If Not(FileExist(ResFile)) Then
  begin
    ResStr:='Resource file :"'+ResFile+'" not found!';
    ReadStrRes:=ResStr;
    Exit;
  end;
  Assign(txt,ResFile);
  Reset(txt);
  Res:=IOResult;

  If EOF(txt) Then Res:=-1;

  While     Not(EOF(txt))
        And Not(Found)
        And (Res=0)
        Do
  begin
    Readln(txt,ResStr);
    Res:=IOResult;
    GETSETUP(ResStr,IDStr,IDVal) ;
    Found:=(IDStr='ID') And (GetLInt(IDVal)=ID);
    If Found Then
    begin
      If EOF(txt) Then Res:=-1;
      While     Not(EOF(txt))
            And (Res=0)
            And (LineCtr<>Line)
            Do
      begin
        Readln(txt,ResStr);
        Res:=IOResult;

        GETSETUP(ResStr,IDStr,IDVal) ;      { prüfe ob resourceeintrag zuende } //OemToAnsi Chg#179 (02.03.04 P.W)
        If (IDStr='ID') Then
        begin
           ResStr:='';                      { falls weniger Zeilen in der Resource stehen }
           LineCtr:=Line;                   { soll ein Leerstring zurückgegeben werden } //OemToAnsi Chg#178 (02.03.04 P.W)
        end
        else
           Inc(LineCtr);
      end;
    end;
  end;

  If Not(Found) Then
     ResStr:='ID "'+GetIntStr(ID,5)+'" in "'+ResFile+'" not found';

  If (Res<>0)   Then
     ResStr:='Error reading ID "'+GetIntStr(ID,5)+'" in "'+ResFile+'"';

  Repeat Until IOResult=0;
  Close(txt);
  Repeat Until IOResult=0;
  ReadStrRes:=ResStr;
end;
