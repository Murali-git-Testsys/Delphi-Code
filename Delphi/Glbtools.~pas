Function  MyGetDate:String10;
{
  returns : DD.MM.YYYY
}
var
  Year, Month, Day, DayOfWeek: Word;
  Res                        : String10;
begin
  GetDate(Year, Month, Day, DayOfWeek);
  Res:=ExchangeChar(GetIntStr(Day,2),[' '],'0')+'.'
       +ExchangeChar(GetIntStr(Month,2),[' '],'0')+'.'
       +ExchangeChar(GetIntStr(Year,4),[' '],'0');
  MyGetDate:=Res;
end;

