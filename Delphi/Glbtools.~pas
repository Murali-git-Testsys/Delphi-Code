Function Scale_1_2_5(MMSmax: Double): Double;
(*
Created: {27.06.03 P.W}
Aim    : Returns next fitting value 1.0 2.0 5.0 10.0 ...
         beeing smaller (absolute) than MMSMax
         1.23 -->  1.0;
         -5.5 --> -5.0
          0.0 -->  0.0;
          9.9 -->  5.0;
         10.1 --> 10.0;
*)
Var
  Ready            : Boolean;
  Factor           : Double;
begin {Func. Scale_1_2_5}
  Factor := 1.0;
  If (MMSmax <> 0.0) then
  begin
    If MMSMax < 0.0 then
    begin
      Factor := -1.0;
      MMSMax := -MMSMax;
    end;

    While MMSMax > 1.0 do
    begin
      MMSMax := MMSMax / 10;
      Factor := Factor * 10;
    end;
    While MMSMax < 0.1 do
    begin
      MMSMax := MMSMax * 10;
      Factor := Factor / 10;
    end;

    Repeat
      Ready := True;
      If MMSmax >= 1.0 then MMSmax :=  1.0
      else
      If MMSmax >= 0.5 then MMSmax :=  0.5
      else
      If MMSmax >= 0.2 then MMSmax :=  0.2
      else
        begin
          Ready := False;
          MMSMax := MMSMax * 10;
          Factor := Factor / 10;
        end;
    Until Ready;
  end;
  Scale_1_2_5:=MMSmax*Factor
end;  {Func. Scale_1_2_5}
{-----------------------------------------------------------------------}
Procedure ChangeInSteps(Var Extend: Double; Step: Smallint); {27.06.03 P.W}
(*
{27.06.03 P.W}
Aim: modify non zero values : like 10 -> 11 -> 12 -> .. -> 48 -> 50 -> 55 ...
 (positive and negative values)
*)
Var
  Factor           : Double;
  HExtend : Smallint;
begin
  If (Abs(Extend) <> 0.0) then
  begin
    Factor := 1;
    While (Abs(Extend) > 999) do
    begin
      Extend := Extend / 10;
      Factor := Factor * 10;
    end;

    While (Abs(Extend) < 99) and (Extend <>0) do
    begin
      Extend := Extend * 10;
      Factor := Factor / 10;
    end;

    HExtend:=Abs(Round(Extend));

    If (HExtend >= 500) then Extend := 50 * Round (Step+(Extend / 50))
    else
    If (HExtend >= 200) then Extend := 20 * Round (Step+(Extend / 20))
    else
                             Extend := 10 * Round (Step+(Extend / 10));

    Extend := Extend * Factor;
  end;
end;
