Procedure CompletePath(Var Test:String);
{     {22.11.94 Michael Welsch
      Aufgabe:
      Pfadangaben wie: '\test\...' oder 'test\..'
      werden completiert
      z.B:     '\' -> 'C:\'
               'A' -> 'C:\TEST\A'
      08.03.95 Michael Welsch
               '.\INIT\' ->'C:\DICHTE\INIT\' , falls C:\DICHTE aktuelles Verzeichnis ist!
               Das geht auch mit FExpand!!!
}
Var
  P,Q   :       Byte;
  S     :       String;
begin
  P:=Pos(':',Test);
  If P=2 Then Exit;                   { C:\...}

  GetDir(0,S);                        { get actual directory }

  If (P=1) Then delete(Test,1,1);     { :\... -> \... }
  Q:=Pos('\',Test);

  If Q=1 Then                         { \... }
  begin
    If (Length(S)=3) Then
       delete(S,Length(S),1)
    else
       S:=Copy(S,1,2);
    Test:=S+Test;
  end
  else                                { ...\... }
  begin
    If (Test[1]='.') Then delete(Test,1,2); {08.03.95 Michael Welsch} {.\TTT -> TTT }
    If (Test[1]='\') Then delete(Test,1,1); {28.07.95 Michael Welsch}
    If (S[Length(S)]<>'\') Then S:=S+'\';
    Test:=S+Test;
  end;
end;
