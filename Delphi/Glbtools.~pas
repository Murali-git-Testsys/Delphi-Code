Function PackedDateToString(DDD:LongInt):String10;
var
  DT    :       DateTime;
  HStr  :       String;
(*
DateTime = record
  Year,Month,Day,Hour,Min,Sec: Word;
end;
*)
begin
  UnpackTime(DDD,DT);
  With DT Do
  begin
    HStr:=ExchangeChar(GetIntStr(Day,2),[' '],'0')+'.';
    HStr:=HStr+ExchangeChar(GetIntStr(Month,2),[' '],'0')+'.';
    HStr:=HStr+copy(ExchangeChar(GetIntStr(Year,4),[' '],'0'),3,2);
  end;
  PackedDateToString:=HStr;
end;
