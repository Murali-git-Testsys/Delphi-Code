PROCEDURE DELAYTIME(WaitSec: Double) ;
(*
Complete new code: {09.07.03 P.W}
Modifications:
{09.07.03 P.W}
  Allow abort with "KeyPressed" if minimum 1 sec waited
*)
Var
  Aborted, Ready   : Boolean;
  RemainSec        : Double;
  WaitedSec        : Double;
  Timer            : tDosTimer;
  DelayMSec        : Smallint;
BEGIN {Proc. DELAYTIME}
  Aborted     := False;
  RemainSec   := WaitSec;
  StartDosTimer  (Timer);

  Repeat

    DelayMSec := Round(MinD(100, MaxD(0,RemainSec*1000)));
    Delay        (DelayMSec);
    WaitedSec := ReadDosTimer(Timer);
    RemainSec := WaitSec - WaitedSec;
    Ready     := (RemainSec <= 0);

    If (not Ready) and (WaitedSec >= 1.0)
      then Aborted := KeyPressed;

  until Ready or Aborted;
END;  {Proc. DELAYTIME}
(*  {until: 09.07.03 P.W}
PROCEDURE DELAYTIME(Wait:Real) ;

VAR
  ST,MIN,SEC,HUSEC    : WORD ;
  RSEC,SSEC,DEL       : REAL ;

BEGIN
  GETTIME(ST,MIN,SEC,HUSEC) ;
  RSEC := SEC+(HUSEC+0.1)/100 ;
  REPEAT
    GETTIME(ST,MIN,SEC,HUSEC) ;
    SSEC := SEC+(HUSEC+0.1)/100 ;
    DEL := ABS(SSEC-RSEC) ;
  UNTIL DEL > Wait ;
END ;
*)
