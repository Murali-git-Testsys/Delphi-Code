Function DaysToDatStr(Days:LongInt):String10;
{28.09.95 Michael Welsch}
{11.12.96 MW Use IsLeapYear and take account all leapyears between}
//Const
//        MonDays:Array[0..12] Of Smallint = (0,31,28,31,30,31,30,31,
//                                    31,30,31,30,31);
var
  MonDays : TMonthDays; // = (0,31,28,31,30,31,30,31,31,30,31,30,31);
Var
  Day,Month          : String02;
  Year               : String04;
  i                  : Byte;
  Result_             : LongInt;
begin
  MonDays := MonthDays;
     Day:='';
     Month:='';
     Year:='';
     i:=0;

     Result_:=0;
     While Days>365 Do
     begin
       If IsLeapyear(Result_) Then
         Dec(Days,366)
       else
         Dec(Days,365);
       Inc(Result_);
     end;
     If Days=0 Then             { the date is the 31.12 of a leapyear }
     begin
       Dec(Result_);
       Days:=366;
     end;

     If IsLeapyear(Result_) Then MonDays[2]:=29
     else MonDays[2]:=28;


     Year:=ExchangeChar(GetIntStr(Result_,4),[' '],'0');
     If Days>0 Then i:=1;
     While (i<=12) and (Days>MonDays[i]) Do {13.12.96 MW, check i}
     begin
        Days:=Days-MonDays[i];
        Inc(i);
     end;
     If i<10 Then Month:='0'+GetIntStr(i,1)
     else Month:=GetIntStr(i,2);
     If Days<10 Then Day:='0'+GetIntStr(Days,1)
     else Day:=GetIntStr(Days,2);
     DaysToDatStr:=Day+'.'+Month+'.'+Year;
end;

