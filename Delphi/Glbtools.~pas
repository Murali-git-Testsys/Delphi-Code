Procedure  GetCollectionPathList(BasePath:String;Var List:PStringCollection;AddBase:Boolean);
{01.09.97 MW}
(*
Modifications:
{17.09.03 P.W}
  correct test of attributes:
            ReadOnly
            Hidden
            SysFile
            VolumeID
            Directory
            Archive
            AnyFile
         SearchRec


*)
Var
  F       :       SearchRec;
  SC      :       Smallint;
  PS      :       PString;
begin
  If List=NIL Then
    List:=New(PStringCollection,Init(10,5));
  AppendBackslash(BasePath);
  BasePath:=DoFSplit(BasePath,C_Dir);
  FindFirstDE(BasePath+'*.*',Directory,F);
  while DosError = 0 do
  begin
    {If (F.Attr=Directory)                   {u.: 17.09.03 P.W}
    If ((F.Attr and Directory) <> 0)         {s.: 17.09.03 P.W}
       And (F.Name<>'.') And (F.Name<>'..') Then
    begin
      SC:=List^.Count;
      If AddBase Then
        PS:=Objects.NewStr(BasePath+F.Name)
      else
        PS:=Objects.NewStr(F.Name);
      List^.Insert(PS);
      If SC=List^.Count Then  {item already in collection}
        Objects.DisposeStr(PS);
    end;
    FindNextDE(F);
  end;
  ChkFindClose(F); // ChkFindClose (05.03.04 P.W)
end;
