Function StringComposer(const EinStr,NewPart:String;Delimiter:Char;Num:Byte):String;
{15.11.96 Michael Welsch, the counterpart to Stringparser!!}
Var
  Str,Str2   :       String;
  I,Ctr :       Smallint;
begin
  Str:=EinStr;
  Ctr:=CountCharInStr(Str,Delimiter);
  Str2:=' '+Delimiter+' ';
  If Num>Ctr Then
  begin
    For I:=1 To Num-Ctr Do
      Str:=Str+Str2;
  end;
  Ctr:=CountCharInStr(Str,Delimiter);
  Str2:=Str;
  Str:='';
  For I:=1 To Ctr Do
  begin
    If I<>Num Then
      Str:=Str+StringParser(Str2,Delimiter,I)+Delimiter
    else
      Str:=Str+NewPart+Delimiter;
  end;
  StringComposer:=Str;
end;

