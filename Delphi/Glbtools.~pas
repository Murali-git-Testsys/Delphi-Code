Function  GetFile_TopNumExt(Path,Name:String):PathStr;
{07.05.97 MW
Purpose: get the file with the highest extension. Uses a sorted list
and ignores all extensions that are not numerical.
}
Var
  List          : PStringCollection;
  I,ZW          : Smallint;
  Code          : LongInt;
  HStr          : String;
  ResStr        : PathStr;
begin
  ResStr:='';
  Name:=DelSpcLR(Name);
  Path:=DelSpcLR(Path);
  AppendBackSlash(Path);
  List:=New(PStringCollection,Init(2,2)); { this is a sorted collection !! }
  GetCollectionFileList(Path,Name+'.*',List);
  { the sorted list may contain (i.e): N.000, N.001, N.BAK ...other not numerical extensions }
  I:=List^.Count-1;
  While (I>=0) Do
  begin
    HStr:=PString(List^.At(I))^;
    VAL(Copy(DoFSplit(HStr,C_Ext),2,3),ZW,CODE) ;
    if ZW=0 then {donothing}; // force use of ZW 29.06.04 P.W
    If Code=0 Then
    begin
      ResStr:=HStr;
      I:=-1; { to break the loop }
    end else
      Dec(I);
  end;
  Dispose(List,Done);
  GetFile_TopNumExt:=ResStr;
end;

