  then AppStratec := AS_Analyse
  else if (Pos('FEMURPC', UpperCase(Caption)) > 0)
  then AppStratec := AS_MeasMod
  else if (Pos('XBJOB', UpperCase(Caption)) > 0)
  then AppStratec := AS_XbJob
  else if (Pos('SVCOMP', UpperCase(Caption)) > 0)
  then AppStratec :=   AS_SvComp
  else if (Pos('CTFEM', UpperCase(Caption)) > 0)
  then AppStratec :=   AS_BackPro
  else if (Pos('XTRACT', UpperCase(Caption)) > 0)
  then AppStratec :=   AS_Xtract
  else if (Pos('XCTDIRECTOR', UpperCase(Caption)) > 0)
  then AppStratec :=   AS_XctDirector
  else if (Pos('BNLOCK', UpperCase(Caption)) > 0)
  then AppStratec :=   AS_BnLock
  ;
end;

function GetConnectedValueDbl(const Val; ConnectType: TConType): Double;
// 12.03.09 P.W
begin
  Result := 0;
  if Assigned(@Val) then
    case ConnectType of
      ct_None    : Result := 0;
      ct_int8    : Result := int8     (Val); // ShortInt
      ct_int16   : Result := int16    (Val); // SmallInt
      ct_int32   : Result := int32    (Val); // Integer
      ct_int64   : Result := int64    (Val); // Int64
      ct_uInt8   : Result := uInt8    (Val); // Byte
      ct_uInt16  : Result := uInt16   (Val); // Word
      ct_uInt32  : Result := uInt32   (Val); // LongWord
      ct_uInt64  : Result := uInt64   (Val); // ???
      ct_float32 : Result := float32  (Val); // Single
      ct_float64 : Result := float64  (Val); // Double
      ct_LVBool  : Result := LVBoolean(Val); // Byte
    end;
end;

function GetConnectedValueStr(const Val; ConnectType: TConType): AnsiString;
// 12.03.09 P.W
begin
  Result := '';
  if Assigned(@Val) then
    case ConnectType of
      ct_char2     : Result := char2     (Val); // [0..1]Char
      ct_char3     : Result := char3     (Val); // [0..2]Char
      ct_char12    : Result := char12    (Val); // [0..11]Char
      ct_char16    : Result := char16    (Val); // [0..15]Char
      ct_char192   : Result := char192   (Val); // [0..191]Char
      ct_AnsiString: Result := AnsiString(Val); // AnsiString
    end;
end;

procedure SetConnectedValueDbl(var Val; ConnectType: TConType; const aValue: Double);
// 12.03.09 P.W
begin
  if Assigned(@Val) then
    case ConnectType of
      ct_int8    : int8     (Val) := Round(aValue); // ShortInt
      ct_int16   : int16    (Val) := Round(aValue); // SmallInt
      ct_int32   : int32    (Val) := Round(aValue); // Integer
      ct_int64   : int64    (Val) := Round(aValue); // Int64
      ct_uInt8   : uInt8    (Val) := Round(aValue); // Byte
      ct_uInt16  : uInt16   (Val) := Round(aValue); // Word
      ct_uInt32  : uInt32   (Val) := Round(aValue); // LongWord
      ct_uInt64  : uInt64   (Val) := Round(aValue); // uInt64
      ct_float32 : float32  (Val) :=       aValue ; // Single
      ct_float64 : float64  (Val) :=       aValue ; // Double
      ct_LVBool  : LVBoolean(Val) := Round(aValue); // Byte
    end;
end;

procedure SetConnectedValueStr(var Val; ConnectType: TConType; const aValue: AnsiString);
// 12.03.09 P.W
type
  charX = Array[0..MaxInt-1] of Char;
var
  Siz, Len, I, I1 : Integer;
begin
  if Assigned(@Val) then
  begin
    case ConnectType of
      ct_char2     : Siz := SizeOf(char2);   // [0..1]Char
      ct_char3     : Siz := SizeOf(char3);   // [0..2]Char
      ct_char12    : Siz := SizeOf(char12);  // [0..11]Char
      ct_char16    : Siz := SizeOf(char16);  // [0..15]Char
      ct_char192   : Siz := SizeOf(char192); // [0..191]Char
      ct_AnsiString: Siz := 0;               // AnsiString
      else           Siz := 0;
    end;
    if ConnectType = ct_AnsiString then
    begin
      AnsiString(Val) := aValue;
    end else
    begin
      Len := Length(aValue);
      I1  := Min(Len, Siz);
      for I := 0 to I1 -1 do
        charX(Val)[I] := aValue[I+1];
      for I := I1 to Siz -1 do
        charX(Val)[I] := #0;
    end;
  end;
end;

function GetConnectedSize(ConnectedType: TConType): Integer;
begin
  case ConnectedType of
    ct_None      : Result := 0;
    ct_int8      : Result := SizeOf(int8      ); // ShortInt
    ct_int16     : Result := SizeOf(int16     ); // SmallInt
    ct_int32     : Result := SizeOf(int32     ); // Integer
    ct_int64     : Result := SizeOf(int64     ); // Int64
    ct_uInt8     : Result := SizeOf(uInt8     ); // Byte
    ct_uInt16    : Result := SizeOf(uInt16    ); // Word
    ct_uInt32    : Result := SizeOf(uInt32    ); // LongWord
    ct_uInt64    : Result := SizeOf(uInt64    ); // uInt64
    ct_float32   : Result := SizeOf(float32   ); // Single
    ct_float64   : Result := SizeOf(float64   ); // Double
    ct_LVBool    : Result := SizeOf(LVBoolean ); // Byte
    ct_char2     : Result := SizeOf(char2     ); // [0..1]Char
    ct_char3     : Result := SizeOf(char3     ); // [0..2]Char
    ct_char12    : Result := SizeOf(char12    ); // [0..11]Char
    ct_char16    : Result := SizeOf(char16    ); // [0..15]Char
    ct_char192   : Result := SizeOf(char192   ); // [0..191]Char
    ct_AnsiString: Result := SizeOf(AnsiString); // AnsiString     // 4!
    else
      raise(Exception.CreateFmt('ConnectedType not supported! (%d)', [Ord(ConnectedType)]));
  end;
end;

