(** Description      : Check if S represents MotPosParNotUsed ..          **)
(***************************************************************************)
(** Called By        : any                                                **)
(** Calls            : -                                                  **)
(** Input            : S                                                  **)
(** Output           : RETURN (tMotParUse): MPU                           **)
(** Global Variables                                                      **)
